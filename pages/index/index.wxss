page {
  --bg-primary: #F8F5F2;
  --bg-card: #FFFFFF;
  --pink-primary: #D4A574;
  --pink-dark: #B8935F;
  --pink-light: #E8D5C4;
  --text-primary: #2C2C2C;
  --text-secondary: #5A5A5A;
  --text-muted: #8A8A8A;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.container {
  padding: 32rpx;
  padding-bottom: 48rpx;
  background: var(--bg-primary);
  min-height: 100vh;
}

/* 欢迎区域 */
.welcome-section {
  margin-bottom: 32rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.welcome-title {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.welcome-subtitle {
  font-size: 26rpx;
  color: var(--text-muted);
  font-weight: 400;
}

/* 统计栏 */
.stats-bar {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32rpx;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.stat-number {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--pink-primary);
  display: block;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 地图区域 */
.map-section {
  margin-bottom: 32rpx;
}

.section-header {
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-subtitle {
  font-size: 22rpx;
  color: var(--text-muted);
}

.section-more {
  font-size: 24rpx;
  color: var(--pink-primary);
}

/* 地图容器 */
.map-wrapper {
  position: relative;
  width: 100%;
  height: 500rpx;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

/* 原生地图组件 */
.map-component {
  width: 100%;
  height: 100%;
}

/* 图例 */
.map-legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-top: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-dot.visited {
  background: var(--pink-primary);
  box-shadow: 0 0 8rpx rgba(212, 165, 116, 0.4);
}

.legend-dot.unvisited {
  background: #D0D0D0;
}

.legend-text {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 探索进度 */
.progress-section {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.progress-percent {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--pink-primary);
}

.progress-bar {
  height: 8rpx;
  background: #F0F0F0;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--pink-light), var(--pink-primary));
  border-radius: 4rpx;
  transition: width 1s ease;
}

.progress-desc {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 最近记录 */
.recent-section {
  margin-bottom: 32rpx;
}

.recent-scroll {
  width: 100%;
}

.recent-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx;
}

.recent-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.recent-image-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.recent-image {
  width: 100%;
  height: 100%;
}

.recent-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #E8D5C4, #F0E6D8);
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-text {
  font-size: 24rpx;
  color: var(--text-muted);
}

.recent-info {
  text-align: center;
}

.recent-name {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 2rpx;
}

.recent-date {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
}

.btn-pink {
  background: var(--pink-primary);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(212, 165, 116, 0.3);
}

.btn-secondary {
  background: var(--bg-card);
  color: var(--text-primary);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}
