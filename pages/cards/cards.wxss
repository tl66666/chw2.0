.container {
  padding: 32rpx;
  background: var(--bg-primary);
  min-height: 100vh;
}

/* 页面标题 */
.cards-header {
  margin-bottom: 32rpx;
}

.cards-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
}

.cards-stats {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.stats-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background: var(--gold-light);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--gold-primary) 0%, var(--gold-secondary) 100%);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.filter-tab {
  padding: 16rpx 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  box-shadow: var(--shadow-sm);
}

.filter-tab.active {
  border-color: var(--gold-primary);
  background: linear-gradient(135deg, rgba(212, 165, 116, 0.1) 0%, rgba(212, 165, 116, 0.05) 100%);
}

.filter-tab text {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.filter-tab.active text {
  color: var(--gold-primary);
  font-weight: 600;
}

.owned-tab.active {
  border-color: var(--pink-primary, #F4A6B5);
  background: linear-gradient(135deg, rgba(244, 166, 181, 0.1) 0%, rgba(244, 166, 181, 0.05) 100%);
}

.owned-tab.active text {
  color: var(--pink-primary, #F4A6B5);
}

/* 角色卡网格 */
.cards-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.card-item {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  transition: transform 0.3s;
}

.card-item:active {
  transform: scale(0.98);
}

.card-item.locked {
  opacity: 0.7;
}

.card-image-wrapper {
  position: relative;
  width: 100%;
  height: 300rpx;
  overflow: hidden;
}

.card-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.card-image.grayscale {
  filter: grayscale(100%);
}

.card-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.lock-text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.rarity-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
}

.rarity-badge text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.card-info {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.card-title {
  font-size: 24rpx;
  color: var(--gold-primary);
  font-weight: 500;
}

.card-province {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  gap: 24rpx;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  text-align: center;
}
