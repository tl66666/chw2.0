.launch-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
}

/* 背景图片 */
.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 背景装饰 */
.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.15;
}

.circle-1 {
  width: 600rpx;
  height: 600rpx;
  background: linear-gradient(135deg, #F4A6B5 0%, #F9D5BB 100%);
  top: -200rpx;
  right: -200rpx;
  animation: float 8s ease-in-out infinite;
}

.circle-2 {
  width: 400rpx;
  height: 400rpx;
  background: linear-gradient(135deg, #A8D8EA 0%, #AA96DA 100%);
  bottom: 200rpx;
  left: -150rpx;
  animation: float 10s ease-in-out infinite reverse;
}

.circle-3 {
  width: 300rpx;
  height: 300rpx;
  background: linear-gradient(135deg, #FCBAD3 0%, #FFFFD2 100%);
  bottom: -100rpx;
  right: 100rpx;
  animation: float 12s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-30rpx) scale(1.05);
  }
}

/* 主内容区 */
.content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
  flex: 1;
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo-wrapper {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.logo-image {
  width: 100%;
  height: 100%;
  border-radius: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(244, 166, 181, 0.3);
  animation: logoPulse 3s ease-in-out infinite;
}

.logo-glow {
  position: absolute;
  top: -20rpx;
  left: -20rpx;
  right: -20rpx;
  bottom: -20rpx;
  background: radial-gradient(circle, rgba(244, 166, 181, 0.2) 0%, transparent 70%);
  border-radius: 50%;
  animation: glowPulse 3s ease-in-out infinite;
}

@keyframes logoPulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

@keyframes glowPulse {
  0%, 100% {
    opacity: 0.5;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.1);
  }
}

.app-name {
  font-size: 56rpx;
  font-weight: 800;
  color: #2D3436;
  margin-bottom: 16rpx;
  letter-spacing: 8rpx;
  background: linear-gradient(135deg, #F4A6B5 0%, #AA96DA 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.app-slogan {
  font-size: 28rpx;
  color: #636E72;
  letter-spacing: 4rpx;
}

/* 数据统计区 */
.stats-section {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 30rpx 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.05);
  animation: slideUp 1s ease-out 0.5s both;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 30rpx;
}

.stat-number {
  font-size: 40rpx;
  font-weight: 700;
  color: #F4A6B5;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #636E72;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: linear-gradient(180deg, transparent 0%, #DDD 50%, transparent 100%);
}

/* 功能亮点 */
.features-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  animation: slideUp 1s ease-out 0.8s both;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  padding: 20rpx 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.feature-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.feature-text {
  font-size: 26rpx;
  color: #2D3436;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 底部按钮区 */
.bottom-section {
  position: relative;
  z-index: 2;
  width: 100%;
  padding: 0 60rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  padding: 28rpx 0;
  border-radius: 100rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.3s;
}

.btn-wechat {
  background: linear-gradient(135deg, #07C160 0%, #05A050 100%);
  color: #FFFFFF;
  box-shadow: 0 12rpx 40rpx rgba(7, 193, 96, 0.3);
}

.btn-wechat:active {
  transform: scale(0.98);
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.2);
}

.btn-icon {
  font-size: 32rpx;
}

.btn-icon-wechat {
  width: 40rpx;
  height: 40rpx;
  background: #FFFFFF;
  border-radius: 8rpx;
  position: relative;
}

.btn-icon-wechat::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 28rpx;
  height: 24rpx;
  background: #07C160;
  border-radius: 6rpx;
}

.btn-icon-wechat::after {
  content: '';
  position: absolute;
  top: 45%;
  left: 35%;
  width: 6rpx;
  height: 6rpx;
  background: #FFFFFF;
  border-radius: 50%;
  box-shadow: 10rpx 0 0 #FFFFFF;
}

.btn-guest {
  background: rgba(255, 255, 255, 0.9);
  color: #636E72;
  border: 2rpx solid rgba(0, 0, 0, 0.1);
}

.btn-guest:active {
  background: rgba(255, 255, 255, 1);
  transform: scale(0.98);
}

.btn-enter {
  background: linear-gradient(135deg, #F4A6B5 0%, #AA96DA 100%);
  color: #FFFFFF;
  box-shadow: 0 12rpx 40rpx rgba(244, 166, 181, 0.3);
}

.btn-enter:active {
  transform: scale(0.98);
}

.btn-arrow {
  font-size: 32rpx;
  margin-left: 8rpx;
  animation: arrowMove 1.5s ease-in-out infinite;
}

@keyframes arrowMove {
  0%, 100% {
    transform: translateX(0);
  }
  50% {
    transform: translateX(10rpx);
  }
}

/* 用户信息 */
.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.user-name {
  font-size: 28rpx;
  color: #2D3436;
  font-weight: 600;
}

/* 协议文字 */
.agreement-text {
  font-size: 22rpx;
  color: #B2BEC3;
  text-align: center;
}

/* 版本号 */
.version {
  position: absolute;
  bottom: 20rpx;
  right: 30rpx;
  font-size: 20rpx;
  color: #B2BEC3;
  z-index: 2;
}