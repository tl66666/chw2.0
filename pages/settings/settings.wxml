<view class="page-container">
  <!-- 头部 -->
  <view class="header-section">
    <text class="header-title">设置</text>
  </view>

  <!-- 外观设置卡片 -->
  <view class="card">
    <view class="card-title">外观</view>
    <view class="setting-item">
      <view class="item-left">
        <view class="icon-box icon-theme"></view>
        <text class="setting-label">主题切换</text>
      </view>
      <view class="item-right">
        <text class="setting-value">{{isDarkMode ? '深色' : '浅色'}}</text>
        <switch class="setting-switch" checked="{{isDarkMode}}" bindchange="toggleTheme" color="#4A90D9"/>
      </view>
    </view>
  </view>

  <!-- 地图显示设置卡片 -->
  <view class="card">
    <view class="card-title">地图显示</view>
    <view class="setting-item">
      <view class="item-left">
        <view class="icon-box icon-map"></view>
        <text class="setting-label">显示省份名</text>
      </view>
      <view class="item-right">
        <switch class="setting-switch" checked="{{showProvinceName}}" bindchange="toggleProvinceName" color="#4A90D9"/>
      </view>
    </view>
    <view class="setting-item">
      <view class="item-left">
        <view class="icon-box icon-city"></view>
        <text class="setting-label">显示城市数</text>
      </view>
      <view class="item-right">
        <switch class="setting-switch" checked="{{showCityCount}}" bindchange="toggleCityCount" color="#4A90D9"/>
      </view>
    </view>
  </view>

  <!-- 通知设置卡片 -->
  <view class="card">
    <view class="card-title">通知</view>
    <view class="setting-item">
      <view class="item-left">
        <view class="icon-box icon-notify"></view>
        <text class="setting-label">接收通知</text>
      </view>
      <view class="item-right">
        <switch class="setting-switch" checked="{{enableNotification}}" bindchange="toggleNotification" color="#4A90D9"/>
      </view>
    </view>
  </view>

  <!-- 通用设置卡片 -->
  <view class="card">
    <view class="card-title">通用</view>
    <view class="setting-item" bindtap="clearCache">
      <view class="item-left">
        <view class="icon-box icon-clear"></view>
        <text class="setting-label">清除缓存</text>
      </view>
      <view class="item-right">
        <text class="setting-value">{{cacheSize}}</text>
        <view class="arrow"></view>
      </view>
    </view>
    <view class="setting-item" bindtap="aboutUs">
      <view class="item-left">
        <view class="icon-box icon-about"></view>
        <text class="setting-label">关于我们</text>
      </view>
      <view class="item-right">
        <text class="setting-value">v{{version}}</text>
        <view class="arrow"></view>
      </view>
    </view>
    <view class="setting-item" bindtap="showAgreement">
      <view class="item-left">
        <view class="icon-box icon-agreement"></view>
        <text class="setting-label">用户协议</text>
      </view>
      <view class="item-right">
        <view class="arrow"></view>
      </view>
    </view>
    <view class="setting-item" bindtap="showPrivacy">
      <view class="item-left">
        <view class="icon-box icon-privacy"></view>
        <text class="setting-label">隐私政策</text>
      </view>
      <view class="item-right">
        <view class="arrow"></view>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <view class="logout-btn" bindtap="logout">退出登录</view>
  </view>

  <!-- 底部版本信息 -->
  <view class="version-footer">
    <text class="version-text">城会玩2.0 v{{version}}</text>
    <text class="version-sub">用脚步丈量世界</text>
  </view>
</view>
