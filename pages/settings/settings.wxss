.page-container {
  min-height: 100vh;
  background: #F5F6FA;
  padding-bottom: 60rpx;
}

/* 头部 */
.header-section {
  background: linear-gradient(135deg, #4A90D9 0%, #5FA8E8 100%);
  padding: 50rpx 30rpx 60rpx;
  text-align: center;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}

/* 卡片 */
.card {
  margin: 24rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 24rpx;
  color: #8E92A4;
  padding: 0 30rpx 16rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

/* 设置项 */
.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx;
  margin: 0 12rpx;
  border-radius: 12rpx;
  transition: background 0.2s;
}

.setting-item:active {
  background: #F5F6FA;
}

.setting-item + .setting-item {
  border-top: 1rpx solid #F0F1F5;
}

/* 左侧 */
.item-left {
  display: flex;
  align-items: center;
}

/* 图标 */
.icon-box {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.icon-box::before,
.icon-box::after {
  content: '';
  position: absolute;
}

/* 主题图标 - 太阳/月亮 */
.icon-theme {
  background: #FFF3E0;
}
.icon-theme::before {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #FF9800;
}
.icon-theme::after {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 4rpx solid #FF9800;
  background: transparent;
}

/* 地图图标 */
.icon-map {
  background: #E3F2FD;
}
.icon-map::before {
  width: 22rpx;
  height: 18rpx;
  background: #2196F3;
  border-radius: 4rpx;
}
.icon-map::after {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #FFFFFF;
  top: 14rpx;
  left: 14rpx;
}

/* 城市图标 */
.icon-city {
  background: #E8F5E9;
}
.icon-city::before {
  width: 20rpx;
  height: 20rpx;
  background: #4CAF50;
  border-radius: 4rpx 4rpx 0 0;
}
.icon-city::after {
  width: 26rpx;
  height: 6rpx;
  background: #4CAF50;
  bottom: 10rpx;
  border-radius: 2rpx;
}

/* 通知图标 */
.icon-notify {
  background: #F3E5F5;
}
.icon-notify::before {
  width: 20rpx;
  height: 22rpx;
  background: #9C27B0;
  border-radius: 10rpx 10rpx 0 0;
}
.icon-notify::after {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #FFFFFF;
  top: 12rpx;
}

/* 清除图标 */
.icon-clear {
  background: #FFEBEE;
}
.icon-clear::before {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #F44336;
  border-radius: 50%;
  background: transparent;
}
.icon-clear::after {
  width: 3rpx;
  height: 10rpx;
  background: #F44336;
  bottom: 10rpx;
}

/* 关于图标 */
.icon-about {
  background: #E0F7FA;
}
.icon-about::before {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #00BCD4;
  border-radius: 50%;
  background: transparent;
}
.icon-about::after {
  width: 4rpx;
  height: 8rpx;
  background: #00BCD4;
  top: 14rpx;
}

/* 协议图标 */
.icon-agreement {
  background: #E8EAF6;
}
.icon-agreement::before {
  width: 18rpx;
  height: 22rpx;
  background: #3F51B5;
  border-radius: 2rpx;
}
.icon-agreement::after {
  width: 10rpx;
  height: 2rpx;
  background: #FFFFFF;
  top: 16rpx;
}

/* 隐私图标 */
.icon-privacy {
  background: #FFF8E1;
}
.icon-privacy::before {
  width: 22rpx;
  height: 24rpx;
  background: #FFC107;
  border-radius: 4rpx 4rpx 0 0;
  clip-path: polygon(50% 0%, 100% 30%, 100% 100%, 0% 100%, 0% 30%);
}
.icon-privacy::after {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #FFFFFF;
  top: 14rpx;
}

/* 文字 */
.setting-label {
  font-size: 30rpx;
  color: #2D3436;
  font-weight: 500;
}

/* 右侧 */
.item-right {
  display: flex;
  align-items: center;
}

.setting-value {
  font-size: 26rpx;
  color: #B2BEC3;
  margin-right: 12rpx;
}

/* 箭头 */
.arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #C0C4CC;
  border-right: 4rpx solid #C0C4CC;
  transform: rotate(45deg);
  margin-right: 8rpx;
}

/* 开关 */
.setting-switch {
  transform: scale(0.85);
}

/* 退出登录 */
.logout-section {
  margin: 40rpx 24rpx 0;
}

.logout-btn {
  text-align: center;
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  color: #F44336;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  transition: background 0.2s;
}

.logout-btn:active {
  background: #FFEBEE;
}

/* 底部版本 */
.version-footer {
  margin-top: 50rpx;
  text-align: center;
}

.version-text {
  display: block;
  font-size: 24rpx;
  color: #B2BEC3;
  margin-bottom: 8rpx;
}

.version-sub {
  display: block;
  font-size: 22rpx;
  color: #D0D3D9;
}
