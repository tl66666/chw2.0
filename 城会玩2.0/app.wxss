/* 全局样式 - 明亮可爱治愈ins风 */
page {
  --bg-primary: #F8F5F2;
  --bg-secondary: #FFFFFF;
  --bg-card: #FFFFFF;
  --bg-glass: rgba(255, 255, 255, 0.8);
  
  --pink-primary: #D66F58;
  --pink-dark: #B9574D;
  --pink-light: #FFF0EA;
  --pink-glow: rgba(214, 111, 88, 0.22);
  
  --blue-soft: #D99E78;
  --blue-light: #E8F3EF;
  
  --yellow-soft: #FCE38A;
  --yellow-light: #FEF5C8;
  
  --green-soft: #B8E0D2;
  --green-light: #E0F2EC;
  
  --text-primary: #4A4A4A;
  --text-secondary: #6B6B6B;
  --text-muted: #9B9B9B;
  --text-disabled: #C5C5C5;
  
  --border-color: rgba(0, 0, 0, 0.06);
  --border-light: rgba(0, 0, 0, 0.03);
  
  --shadow-sm: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 16rpx 48rpx rgba(0, 0, 0, 0.1);
  --shadow-pink: 0 4rpx 16rpx rgba(214, 111, 88, 0.22);
  
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 36rpx;
  
  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 基础容器 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF8F1 0%, #FFFDF8 58%, #E8F3EF 100%);
  padding: 32rpx;
  box-sizing: border-box;
}

/* 玻璃拟态卡片 - 明亮版 */
.glass-card {
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

/* 粉色按钮 */
.btn-pink {
  background: linear-gradient(135deg, var(--pink-primary) 0%, var(--pink-dark) 100%);
  color: #FFFFFF;
  font-weight: 600;
  border-radius: var(--radius-md);
  padding: 24rpx 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: var(--shadow-pink);
  transition: all 0.3s ease;
}

.btn-pink:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(244, 166, 181, 0.2);
}

/* 次要按钮 */
.btn-secondary {
  background: var(--bg-secondary);
  border: 2rpx solid var(--pink-light);
  color: var(--pink-dark);
  border-radius: var(--radius-md);
  padding: 24rpx 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.3s ease;
}

.btn-secondary:active {
  background: var(--pink-light);
}

/* 金色按钮（兼容旧引用） */
.btn-gold {
  background: linear-gradient(135deg, var(--pink-primary) 0%, var(--pink-dark) 100%);
  color: #FFFFFF;
  font-weight: 600;
  border-radius: var(--radius-md);
  padding: 24rpx 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: var(--shadow-pink);
}

/* 标题样式 */
.title-xl {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 0;
}

.title-lg {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.title-md {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 文字样式 */
.text-primary {
  color: var(--text-primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-muted {
  color: var(--text-muted);
}

.text-pink {
  color: var(--pink-primary);
}

/* 数字高亮 */
.stat-number {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--pink-primary);
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background: var(--border-color);
  margin: 32rpx 0;
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: var(--pink-light);
  border-radius: 100rpx;
  font-size: 22rpx;
  color: var(--pink-dark);
}

/* 输入框 */
.input-soft {
  background: var(--bg-secondary);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 24rpx 32rpx;
  color: var(--text-primary);
  font-size: 28rpx;
}

.input-soft::placeholder {
  color: var(--text-disabled);
}

/* 列表项 */
.list-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}

/* 网格布局 */
.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

/* 照片网格 */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  text-align: center;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  line-height: 1.8;
}

/* 动画 */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.animate-float {
  animation: float 3s ease-in-out infinite;
}

.animate-pulse {
  animation: pulse 2s ease-in-out infinite;
}

/* 安全区域适配 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
