<view class="page-container rarity-{{character.rarity}}">
  <!-- 图片区域：纯净展示，不被文字遮挡 -->
  <view class="card-stage">
    <view class="poster-fallback rarity-{{character.rarity}}">
      <view class="poster-sun"></view>
      <view class="poster-mark">{{provinceShort}}</view>
      <view class="poster-route">
        <view></view>
        <view></view>
        <view></view>
      </view>
    </view>
    <image
      wx:if="{{cardImage}}"
      class="card-image"
      src="{{cardImage}}"
      mode="aspectFill"
      binderror="onCardImageError"
    />
    <view class="locked-cover" wx:if="{{!isUnlocked}}">
      <view class="lock-token"></view>
      <text class="locked-cover-text">未解锁</text>
    </view>
    <view class="rarity-chip" style="background:{{rarityColor}}">{{character.rarity}}</view>
    <view class="province-chip">{{province.name}}</view>
  </view>

  <!-- 信息卡片：独立在图片下方，不遮挡 -->
  <view class="info-card">
    <text class="character-name">{{character.name}}</text>
    <text class="character-title">「{{character.title}}」</text>
    <view class="score-row">
      <text class="score-label">{{isUnlocked ? '角色共鸣' : '线索强度'}}</text>
      <text class="score-value">{{totalScore}}</text>
    </view>
  </view>

  <!-- 属性区域 -->
  <view class="attributes-section">
    <view class="section-header">
      <text class="section-title">{{isUnlocked ? '角色属性' : '待解锁属性预览'}}</text>
      <text class="section-tag">{{isUnlocked ? '已收录' : '点亮后开放'}}</text>
    </view>
    <view class="attr-row">
      <text class="attr-label">文化</text>
      <view class="attr-bar-bg"><view class="attr-bar-fill culture" style="width: {{character.attributes.culture}}%"></view></view>
      <text class="attr-score">{{isUnlocked ? character.attributes.culture : '?'}}</text>
    </view>
    <view class="attr-row">
      <text class="attr-label">潮流</text>
      <view class="attr-bar-bg"><view class="attr-bar-fill fashion" style="width: {{character.attributes.fashion}}%"></view></view>
      <text class="attr-score">{{isUnlocked ? character.attributes.fashion : '?'}}</text>
    </view>
    <view class="attr-row">
      <text class="attr-label">美食</text>
      <view class="attr-bar-bg"><view class="attr-bar-fill food" style="width: {{character.attributes.food}}%"></view></view>
      <text class="attr-score">{{isUnlocked ? character.attributes.food : '?'}}</text>
    </view>
    <view class="attr-row">
      <text class="attr-label">历史</text>
      <view class="attr-bar-bg"><view class="attr-bar-fill history" style="width: {{character.attributes.history}}%"></view></view>
      <text class="attr-score">{{isUnlocked ? character.attributes.history : '?'}}</text>
    </view>
  </view>

  <!-- 专属技能 -->
  <view class="skill-quote-section" wx:if="{{isUnlocked}}">
    <view class="section-header">
      <text class="section-title">专属技能</text>
    </view>
    <view class="skill-pill">{{character.skill}}</view>
    <view class="quote-row">
      <text class="quote-text">"{{character.quote}}"</text>
    </view>
  </view>

  <!-- 角色故事 -->
  <view class="story-section" wx:if="{{isUnlocked && character.description}}">
    <view class="section-header">
      <text class="section-title">角色故事</text>
    </view>
    <text class="story-text">{{character.description}}</text>
  </view>

  <!-- 未解锁引导 -->
  <view class="locked-section" wx:if="{{!isUnlocked}}">
    <view class="locked-card">
      <text class="locked-title">去地图点亮 {{province.name}}</text>
      <text class="locked-hint">点亮这个省份任意城市后，会自动解锁这张角色卡，并开启完整属性、台词和角色故事。</text>
      <button class="map-btn" bindtap="goToMap">去地图打卡</button>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-actions">
    <button class="action-btn btn-back" bindtap="goBack">返回</button>
    <button class="action-btn btn-share" open-type="share">分享</button>
  </view>
</view>
