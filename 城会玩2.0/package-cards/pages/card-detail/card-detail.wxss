.page-container {
  min-height: 100vh;
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #FFF7F0 0%, #FFFDF8 52%, #EAF4F0 100%);
}

/* ===== 图片区域 ===== */
.card-stage {
  position: relative;
  aspect-ratio: 3 / 4;
  min-height: 680rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #F3E9DF;
  box-shadow: 0 20rpx 50rpx rgba(77, 51, 42, 0.14);
}

.poster-fallback,
.card-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.card-image {
  z-index: 2;
  padding: 18rpx;
  box-sizing: border-box;
}

.poster-fallback {
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #F9E3D4 0%, #FFF8EF 48%, #DCECE6 100%);
}

.poster-fallback.rarity-UR { background: linear-gradient(145deg, #FFE0D5 0%, #F7D5DA 48%, #D7E8E2 100%); }
.poster-fallback.rarity-SSR { background: linear-gradient(145deg, #F7D6A4 0%, #FFF2DC 50%, #DCECE6 100%); }
.poster-fallback.rarity-SR { background: linear-gradient(145deg, #D7EAE5 0%, #F8F5F2 48%, #D8E3F0 100%); }
.poster-fallback.rarity-R { background: linear-gradient(145deg, #E7DDD5 0%, #F8F5F2 50%, #DEE5E2 100%); }

.poster-sun {
  position: absolute;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.34);
  box-shadow: inset 0 0 0 42rpx rgba(255,255,255,0.18);
}

.poster-mark {
  position: relative;
  z-index: 2;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8F5749;
  font-size: 56rpx;
  font-weight: 900;
  background: rgba(255,255,255,0.7);
  box-shadow: 0 16rpx 34rpx rgba(0,0,0,0.07);
}

.poster-route {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: 44rpx;
  display: flex;
  gap: 12rpx;
}

.poster-route view {
  height: 10rpx;
  flex: 1;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.6);
}

/* 锁定遮罩 */
.locked-cover {
  position: absolute;
  inset: 0;
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background: rgba(45, 39, 35, 0.46);
}

.locked-cover-text {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.lock-token {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.5);
  background: rgba(255,255,255,0.16);
  position: relative;
}

.lock-token::after {
  content: '';
  position: absolute;
  left: 22rpx;
  top: 22rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #FFFFFF;
}

/* 稀有度标签 - 右上角 */
.rarity-chip {
  position: absolute;
  z-index: 5;
  right: 20rpx;
  top: 20rpx;
  min-width: 76rpx;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.16);
}

/* 省份标签 - 左上角 */
.province-chip {
  position: absolute;
  z-index: 5;
  left: 20rpx;
  top: 20rpx;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.88);
  backdrop-filter: blur(8rpx);
  color: #5A4A42;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.1);
}

/* ===== 信息卡片 - 独立在图片下方 ===== */
.info-card {
  position: relative;
  z-index: 8;
  margin: -36rpx 24rpx 0;
  padding: 18rpx 22rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.94);
  box-shadow: 0 12rpx 30rpx rgba(76, 53, 44, 0.1);
  border: 1rpx solid rgba(255,255,255,0.8);
}

.character-name {
  display: block;
  font-size: 36rpx;
  color: #3E352F;
  font-weight: 900;
  line-height: 1.2;
}

.character-title {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #C86B58;
  font-weight: 700;
}

.score-row {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(0,0,0,0.05);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.score-label {
  color: #8A786E;
  font-size: 22rpx;
  font-weight: 700;
}

.score-value {
  color: #D66F58;
  font-size: 28rpx;
  font-weight: 900;
}

/* ===== 通用 section 样式 ===== */
.attributes-section,
.skill-quote-section,
.story-section,
.locked-card {
  margin: 18rpx 0 0;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.9);
  box-shadow: 0 8rpx 24rpx rgba(58, 42, 34, 0.05);
  border: 1rpx solid rgba(255,255,255,0.75);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  color: #3F3732;
  font-weight: 900;
}

.section-tag {
  flex-shrink: 0;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: #FFF0EA;
  color: #D66F58;
  font-size: 20rpx;
  font-weight: 700;
}

/* ===== 属性条 ===== */
.attr-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.attr-label {
  width: 56rpx;
  flex-shrink: 0;
  color: #7A6A62;
  font-size: 24rpx;
  font-weight: 700;
}

.attr-bar-bg {
  flex: 1;
  height: 16rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #EFE7DF;
}

.attr-bar-fill {
  height: 100%;
  border-radius: 999rpx;
}

.attr-bar-fill.culture { background: linear-gradient(90deg, #D66F58, #E9B17D); }
.attr-bar-fill.fashion { background: linear-gradient(90deg, #C85785, #D99E78); }
.attr-bar-fill.food { background: linear-gradient(90deg, #D99E54, #F0CA72); }
.attr-bar-fill.history { background: linear-gradient(90deg, #78B6A6, #6F99C8); }

.attr-score {
  width: 48rpx;
  text-align: right;
  color: #D66F58;
  font-size: 24rpx;
  font-weight: 900;
}

/* ===== 技能 & 台词 ===== */
.skill-pill {
  display: inline-flex;
  min-height: 52rpx;
  align-items: center;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #D66F58, #D99E78);
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 800;
}

.quote-row {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #FFF8F1;
}

.quote-text {
  font-size: 25rpx;
  color: #76665E;
  line-height: 1.7;
}

/* ===== 角色故事 ===== */
.story-text {
  font-size: 26rpx;
  color: #635750;
  line-height: 1.82;
}

/* ===== 未解锁引导 ===== */
.locked-section {
  margin-top: 0;
}

.locked-card {
  text-align: center;
}

.locked-title {
  display: block;
  color: #3F3732;
  font-size: 30rpx;
  font-weight: 900;
}

.locked-hint {
  display: block;
  margin-top: 10rpx;
  color: #8E7F76;
  font-size: 24rpx;
  line-height: 1.7;
}

.map-btn {
  margin-top: 22rpx;
  height: 78rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #D66F58, #78B6A6);
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 78rpx;
  letter-spacing: 1rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  box-sizing: border-box;
}

.map-btn::after {
  border: none;
}

/* ===== 底部按钮 ===== */
.bottom-actions {
  margin-top: 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: 82rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 82rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  letter-spacing: 1rpx;
  padding: 0;
  box-sizing: border-box;
}

.action-btn::after {
  border: none;
}

.btn-back {
  color: #51453F;
  background: #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.04);
}

.btn-share {
  color: #FFFFFF;
  background: #D66F58;
  box-shadow: 0 6rpx 18rpx rgba(214,111,88,0.2);
}
