.cards-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  background: linear-gradient(180deg, #FFF7F0 0%, #FFFDF8 48%, #EAF4F0 100%);
  box-sizing: border-box;
}

.cards-hero {
  min-height: 214rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  background:
    radial-gradient(circle at 18% 18%, rgba(255,255,255,0.72) 0, rgba(255,255,255,0) 120rpx),
    linear-gradient(135deg, #D66F58 0%, #D99E78 54%, #78B6A6 100%);
  box-shadow: 0 16rpx 38rpx rgba(190, 109, 86, 0.22);
  color: #FFFFFF;
  box-sizing: border-box;
}

.eyebrow {
  display: block;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  opacity: 0.82;
  margin-bottom: 8rpx;
}

.cards-title {
  display: block;
  font-size: 48rpx;
  line-height: 1.12;
  font-weight: 800;
}

.cards-desc {
  display: block;
  max-width: 450rpx;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.55;
  opacity: 0.9;
}

.hero-counter {
  width: 132rpx;
  height: 132rpx;
  border-radius: 34rpx;
  flex-shrink: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 26rpx;
  background: rgba(255,255,255,0.24);
  border: 1rpx solid rgba(255,255,255,0.36);
  box-sizing: border-box;
}

.counter-main {
  font-size: 50rpx;
  font-weight: 900;
  line-height: 1;
}

.counter-sub {
  font-size: 22rpx;
  line-height: 1.3;
  opacity: 0.82;
}

.progress-card {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,0.86);
  border: 1rpx solid rgba(214,111,88,0.08);
  box-shadow: 0 8rpx 28rpx rgba(0,0,0,0.05);
}

.progress-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 14rpx;
  font-size: 25rpx;
  color: #6B5E57;
  font-weight: 600;
}

.progress-bar {
  height: 12rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #F1E4DA;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #D66F58, #E9B17D, #78B6A6);
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
  margin-top: 24rpx;
  margin-bottom: 26rpx;
}

.filter-tabs {
  display: flex;
  gap: 14rpx;
}

.filter-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 66rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: #7A6A62;
  background: rgba(255,255,255,0.78);
  border: 1rpx solid rgba(0,0,0,0.04);
}

.filter-tab.active {
  color: #FFFFFF;
  background: #D66F58;
  box-shadow: 0 8rpx 20rpx rgba(214,111,88,0.24);
}

.filter-tab.rarity-UR.active { background: linear-gradient(135deg, #D66F58, #C85785); }
.filter-tab.rarity-SSR.active { background: linear-gradient(135deg, #D99E54, #D66F58); }
.filter-tab.rarity-SR.active { background: linear-gradient(135deg, #78B6A6, #6F99C8); }
.filter-tab.rarity-R.active { background: linear-gradient(135deg, #9B8B82, #6F7774); }
.owned-tab.active { background: linear-gradient(135deg, #365B51, #78B6A6); }

.cards-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx;
}

.card-item {
  border-radius: 22rpx;
  overflow: hidden;
  background: #FFFFFF;
  box-shadow: 0 10rpx 26rpx rgba(58, 42, 34, 0.08);
  border: 1rpx solid rgba(255,255,255,0.8);
}

.card-item:active {
  transform: scale(0.985);
}

.card-item.locked {
  opacity: 0.92;
}

.card-cover {
  position: relative;
  height: 316rpx;
  overflow: hidden;
  background: #F3E9DF;
}

.poster-fallback,
.card-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.card-image {
  z-index: 2;
  top: 18rpx;
  bottom: auto;
  height: 100%;
}

.card-image.grayscale {
  filter: grayscale(90%);
  opacity: 0.78;
}

.poster-fallback {
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #F9E3D4, #F8F5F2 54%, #DCECE6);
}

.poster-fallback.rarity-UR { background: linear-gradient(145deg, #FFE0D5, #F7D5DA 45%, #D7E8E2); }
.poster-fallback.rarity-SSR { background: linear-gradient(145deg, #F7D6A4, #FFF2DC 50%, #DCECE6); }
.poster-fallback.rarity-SR { background: linear-gradient(145deg, #D7EAE5, #F8F5F2 48%, #D8E3F0); }
.poster-fallback.rarity-R { background: linear-gradient(145deg, #E7DDD5, #F8F5F2 50%, #DEE5E2); }

.poster-orbit {
  position: absolute;
  width: 210rpx;
  height: 210rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.7);
  box-shadow: inset 0 0 0 26rpx rgba(255,255,255,0.2);
}

.poster-mark {
  position: relative;
  z-index: 2;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8F5749;
  font-size: 38rpx;
  font-weight: 900;
  background: rgba(255,255,255,0.72);
  box-shadow: 0 10rpx 26rpx rgba(0,0,0,0.08);
}

.poster-lines {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  bottom: 22rpx;
  display: flex;
  gap: 8rpx;
}

.poster-lines view {
  height: 8rpx;
  flex: 1;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.58);
}

.lock-mask {
  position: absolute;
  inset: 0;
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: rgba(255,255,255,0.92);
  font-size: 25rpx;
  font-weight: 800;
  background: rgba(54, 48, 44, 0.38);
}

.lock-dot {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.22);
  border: 2rpx solid rgba(255,255,255,0.54);
  position: relative;
}

.lock-dot::after {
  content: '';
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  left: 16rpx;
  top: 16rpx;
  border-radius: 50%;
  background: #FFFFFF;
}

.rarity-badge {
  position: absolute;
  z-index: 5;
  top: 14rpx;
  right: 14rpx;
  min-width: 58rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 21rpx;
  font-weight: 900;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.16);
}

.rarity-badge.rarity-UR { background: #D66F58; }
.rarity-badge.rarity-SSR { background: #D99E54; }
.rarity-badge.rarity-SR { background: #78B6A6; }
.rarity-badge.rarity-R { background: #8D8A84; }

.card-info {
  padding: 18rpx 18rpx 20rpx;
}

.card-name {
  display: block;
  font-size: 30rpx;
  color: #3F3732;
  font-weight: 800;
  line-height: 1.25;
}

.card-title {
  display: block;
  min-height: 34rpx;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #C86B58;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  font-size: 21rpx;
  color: #9B8E86;
}

.meta-row text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-row text:last-child {
  flex-shrink: 0;
  color: #78A694;
  font-weight: 700;
}

.empty-state {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  text-align: center;
}

.empty-symbol {
  width: 120rpx;
  height: 120rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  color: #D66F58;
  font-size: 44rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 28rpx rgba(0,0,0,0.06);
}

.empty-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #4A403B;
}

.empty-desc {
  width: 460rpx;
  font-size: 24rpx;
  color: #9B8E86;
}
