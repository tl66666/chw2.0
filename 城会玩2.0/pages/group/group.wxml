<view class="group-page">
  <view class="hero">
    <view class="hero-copy">
      <text class="hero-kicker">Travel Squad</text>
      <text class="hero-title">我的群组</text>
      <text class="hero-desc">一个人点亮，全队地图同步。这里汇总成员在城市详情里上传的旅行与美食照片。</text>
    </view>
    <view class="hero-stamp">队</view>
  </view>

  <view class="loading-section" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">同步群组足迹中...</text>
  </view>

  <block wx:if="{{groupInfo && !loading}}">
    <view class="group-card">
      <view class="group-main">
        <text class="group-name">{{groupInfo.name}}</text>
        <text class="group-desc">{{groupTypeText}}小队 · 邀请码 {{inviteCode}}</text>
        <text class="group-sync-state" wx:if="{{!isCloudBacked}}">仅本机保存，联网后才能邀请好友同步</text>
      </view>
      <view class="owner-badge" wx:if="{{isCreator}}">创建者</view>
      <view class="owner-badge member" wx:elif="{{isAdmin}}">管理员</view>
    </view>

    <view class="squad-map-card">
      <view class="squad-map-head">
        <view>
          <text class="section-title">全队足迹地图</text>
          <text class="section-subtitle">任意成员在首页或城市详情点亮后，这座城市就会加入群组地图。</text>
        </view>
        <view class="map-score">{{stats.totalCities}}</view>
      </view>
      <view class="stats-grid">
        <view class="stat-card">
          <text class="stat-number">{{stats.totalMembers}}</text>
          <text class="stat-label">成员</text>
        </view>
        <view class="stat-card">
          <text class="stat-number">{{stats.totalCities}}</text>
          <text class="stat-label">全队城市</text>
        </view>
        <view class="stat-card">
          <text class="stat-number">{{stats.totalProvinces}}</text>
          <text class="stat-label">覆盖省份</text>
        </view>
        <view class="stat-card">
          <text class="stat-number">{{stats.totalPhotos}}</text>
          <text class="stat-label">足迹照片</text>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-header">
        <view>
          <text class="section-title">已点亮城市</text>
          <text class="section-subtitle">不是共同完成，一个成员点亮就会同步给全队。</text>
        </view>
      </view>
      <scroll-view class="city-scroll" scroll-x wx:if="{{groupCities.length > 0}}">
        <view class="city-chip" wx:for="{{groupCities}}" wx:key="cityId">
          <text class="city-name">{{item.cityName}}</text>
          <text class="city-meta">{{item.memberCount}}人留下足迹</text>
        </view>
      </scroll-view>
      <view class="empty-inline" wx:else>还没有群组足迹。任意成员去首页地图点亮城市后，会自动出现在这里。</view>
    </view>

    <view class="section-card plan-section">
      <view class="section-header">
        <view>
          <text class="section-title">旅行计划</text>
          <text class="section-subtitle">把想去的地方放进清单，成员用投票决定下一站。</text>
        </view>
        <view class="section-more" bindtap="showPlanModal">新建计划</view>
      </view>
      <view class="plan-list" wx:if="{{travelPlans.length > 0}}">
        <view class="plan-item" wx:for="{{travelPlans}}" wx:key="id">
          <view class="plan-copy">
            <text class="plan-title">{{item.title}}</text>
            <text class="plan-meta" wx:if="{{item.cityName || item.startDate || item.endDate}}">{{item.cityName}}{{item.cityName && (item.startDate || item.endDate) ? ' · ' : ''}}{{item.startDate || '日期待定'}}{{item.endDate ? ' 至 ' + item.endDate : ''}}</text>
            <text class="plan-note" wx:if="{{item.note}}">{{item.note}}</text>
            <text class="plan-author">发起人：{{item.creatorName}}</text>
          </view>
          <view class="plan-actions">
            <view class="plan-vote {{item.hasVoted ? 'voted' : ''}}" bindtap="togglePlanVote" data-id="{{item.id}}">
              <text>{{item.hasVoted ? '已投' : '投票'}}</text>
              <text class="plan-vote-count">{{item.voteCount}}</text>
            </view>
            <view class="plan-delete" wx:if="{{isCreator || item.isMine}}" bindtap="deleteTravelPlan" data-id="{{item.id}}">删除</view>
          </view>
        </view>
      </view>
      <view class="empty-inline" wx:else>还没有出行计划。先写下一个目的地，让大家投票决定。</view>
    </view>

    <view class="section-card featured-section" wx:if="{{featuredPhotos.length > 0}}">
      <view class="section-header">
        <view>
          <text class="section-title">精选相册</text>
          <text class="section-subtitle">群主从共同回忆中挑选的照片</text>
        </view>
        <text class="featured-count">{{featuredPhotos.length}} / 6</text>
      </view>
      <view class="featured-grid">
        <view class="featured-photo" wx:for="{{featuredPhotos}}" wx:key="id" bindtap="previewImage" data-url="{{item.url}}">
          <image class="featured-photo-img" src="{{item.url}}" mode="aspectFill" lazy-load/>
          <view class="featured-photo-caption">{{item.cityName || '城市足迹'}}</view>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-header">
        <view>
          <text class="section-title">城市照片流</text>
          <text class="section-subtitle">只收录城市详情页上传的旅行/美食照片，和点亮城市绑定。</text>
        </view>
        <view class="section-more" bindtap="showPhotoWall" wx:if="{{sharedPhotos.length > 0}}">查看全部</view>
      </view>
      <scroll-view class="photo-city-scroll" scroll-x wx:if="{{photoCityFilters.length > 1}}">
        <view class="photo-city-filters">
          <view class="photo-city-filter {{photoCityFilter === item.id ? 'active' : ''}}" wx:for="{{photoCityFilters}}" wx:key="id" bindtap="selectPhotoCity" data-city="{{item.id}}">{{item.name}}</view>
        </view>
      </scroll-view>
      <view class="photos-grid" wx:if="{{visibleSharedPhotos.length > 0}}">
        <view class="photo-item" wx:for="{{visibleSharedPhotos}}" wx:key="id" bindtap="previewImage" data-url="{{item.url}}">
          <image class="photo-img" src="{{item.url}}" mode="aspectFill" lazy-load/>
          <view class="featured-badge" wx:if="{{item.isFeatured}}">精选</view>
          <view class="feature-toggle" wx:if="{{isCreator}}" catchtap="toggleFeaturedPhoto" data-id="{{item.id}}" data-featured="{{item.isFeatured}}">{{item.isFeatured ? '取消精选' : '设为精选'}}</view>
          <view class="photo-caption">
            <text>{{item.cityName || '城市足迹'}}</text>
          </view>
        </view>
      </view>
      <view class="empty-inline" wx:elif="{{sharedPhotos.length > 0}}">这座城市还没有群组照片，换一个城市看看。</view>
      <view class="empty-inline" wx:else>还没有照片。成员在城市详情页上传照片后，会按城市同步到这里。</view>
    </view>

    <view class="section-card" wx:if="{{recentActivities.length > 0}}">
      <view class="section-header">
        <view>
          <text class="section-title">小队动态</text>
          <text class="section-subtitle">最近的点亮和照片上传</text>
        </view>
      </view>
      <view class="activity-list">
        <view class="activity-item" wx:for="{{recentActivities}}" wx:key="id">
          <view class="activity-dot {{item.type}}"></view>
          <view class="activity-copy">
            <text class="activity-title">{{item.userName}} {{item.type === 'photo' ? '上传了' : '点亮了'}} {{item.cityName}}</text>
            <text class="activity-time">{{item.displayTime}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-header">
        <view>
          <text class="section-title">成员贡献</text>
          <text class="section-subtitle">按个人点亮城市数排序</text>
        </view>
      </view>
      <view class="member-list">
        <view class="member-item {{item.isCreator ? 'creator-item' : ''}}" wx:for="{{members}}" wx:key="openid">
          <view class="rank-badge">{{index + 1}}</view>
          <image class="member-avatar" src="{{item.avatarUrl || '/images/avatar.jpg'}}" mode="aspectFill"/>
          <view class="member-info">
            <view class="member-name-row">
              <text class="member-name">{{item.nickName}}</text>
              <view class="role-tag" wx:if="{{item.isCreator}}">创建者</view>
            </view>
            <text class="member-sub">{{item.cityCount || 0}} 城市 · {{item.provinceCount || 0}} 省份 · {{item.photoCount || 0}} 照片</text>
          </view>
        </view>
      </view>
    </view>

    <view class="action-section">
      <view class="action-btn invite-btn" bindtap="showInvite">邀请码</view>
      <view class="action-btn leave-btn" bindtap="leaveGroup">退出</view>
    </view>
  </block>

  <view class="empty-section" wx:if="{{!groupInfo && !loading}}">
    <image class="empty-illustration" src="/images/ui/empty-group.jpg" mode="aspectFit"/>
    <text class="empty-title">还没有旅行小队</text>
    <text class="empty-desc">创建或加入群组后，成员点亮的城市和城市详情里的照片会汇成一张全队足迹地图。</text>
    <view class="action-buttons">
      <view class="btn-primary" bindtap="showCreate">创建群组</view>
      <view class="btn-secondary" bindtap="showJoin">输入邀请码</view>
    </view>
  </view>

  <view class="modal" wx:if="{{showCreateModal}}" catchtap="hideCreateModal">
    <view class="modal-content" catchtap="preventClose">
      <view class="modal-header">
        <text class="modal-title">创建旅行小队</text>
        <view class="modal-close" bindtap="hideCreateModal"></view>
      </view>
      <view class="modal-body">
        <text class="form-label">群组名称</text>
        <input class="form-input" placeholder="例如：周末旅行团" value="{{newGroupName}}" bindinput="onGroupNameInput" maxlength="20" focus="{{showCreateModal}}"/>
        <text class="form-label">群组类型</text>
        <view class="type-selector">
          <view class="type-option {{newGroupType === 'friends' ? 'active' : ''}}" bindtap="selectGroupType" data-type="friends">朋友</view>
          <view class="type-option {{newGroupType === 'couple' ? 'active' : ''}}" bindtap="selectGroupType" data-type="couple">情侣</view>
          <view class="type-option {{newGroupType === 'family' ? 'active' : ''}}" bindtap="selectGroupType" data-type="family">家人</view>
        </view>
      </view>
      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="hideCreateModal">取消</view>
        <view class="modal-btn confirm" bindtap="createGroup">创建</view>
      </view>
    </view>
  </view>

  <view class="modal" wx:if="{{showInviteModal}}" catchtap="hideInviteModal">
    <view class="modal-content" catchtap="preventClose">
      <view class="modal-header">
        <text class="modal-title">邀请好友</text>
        <view class="modal-close" bindtap="hideInviteModal"></view>
      </view>
      <view class="invite-card">
        <text class="invite-kicker">旅行小队邀请</text>
        <text class="invite-group-name">{{groupInfo.name}}</text>
        <text class="invite-group-type">{{groupTypeText}}小队</text>
        <view class="invite-code-panel">
          <text class="invite-code-label">邀请码</text>
          <text class="invite-code">{{inviteCode}}</text>
        </view>
        <view class="invite-steps">
          <text class="invite-step">1. 打开「城会玩」并进入群组页</text>
          <text class="invite-step">2. 点击“输入邀请码”，粘贴这串六码</text>
        </view>
      </view>
      <view class="invite-actions">
        <view class="invite-copy-btn" bindtap="copyInviteCode">
          <text>{{copiedInviteCode ? '已复制邀请码' : '复制邀请码'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="modal" wx:if="{{showJoinModal}}" catchtap="hideJoinModal">
    <view class="modal-content" catchtap="preventClose">
      <view class="modal-header">
        <text class="modal-title">加入旅行小队</text>
        <view class="modal-close" bindtap="hideJoinModal"></view>
      </view>
      <view class="modal-body">
        <input class="code-input" placeholder="输入6位邀请码" value="{{joinCode}}" bindinput="onJoinCodeInput" maxlength="6" focus="{{showJoinModal}}"/>
      </view>
      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="hideJoinModal">取消</view>
        <view class="modal-btn confirm" bindtap="joinGroup">加入</view>
      </view>
    </view>
  </view>

  <view class="modal" wx:if="{{showPlanModal}}" catchtap="hidePlanModal">
    <view class="modal-content" catchtap="preventClose">
      <view class="modal-header">
        <text class="modal-title">新建旅行计划</text>
        <view class="modal-close" bindtap="hidePlanModal"></view>
      </view>
      <view class="modal-body">
        <text class="form-label">计划名称</text>
        <input class="form-input" placeholder="例如：五一去重庆吃火锅" value="{{newPlanTitle}}" bindinput="onPlanTitleInput" maxlength="30" focus="{{showPlanModal}}"/>
        <text class="form-label">目的地</text>
        <input class="form-input" placeholder="例如：重庆" value="{{newPlanCity}}" bindinput="onPlanCityInput" maxlength="20"/>
        <view class="plan-date-row">
          <picker mode="date" value="{{newPlanStartDate}}" bindchange="onPlanStartDateChange"><view class="plan-date-input">{{newPlanStartDate || '出发日期待定'}}</view></picker>
          <picker mode="date" value="{{newPlanEndDate}}" bindchange="onPlanEndDateChange"><view class="plan-date-input">{{newPlanEndDate || '返程日期待定'}}</view></picker>
        </view>
        <text class="form-label">补充说明</text>
        <textarea class="plan-note-input" placeholder="写下路线、预算或想一起完成的事" value="{{newPlanNote}}" bindinput="onPlanNoteInput" maxlength="120"/>
      </view>
      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="hidePlanModal">取消</view>
        <view class="modal-btn confirm" bindtap="createTravelPlan">创建计划</view>
      </view>
    </view>
  </view>

  <view class="photos-modal" wx:if="{{showPhotosModal}}">
    <view class="photos-modal-header">
      <text class="photos-modal-title">群组城市照片</text>
      <view class="photos-modal-close" bindtap="hidePhotosModal"></view>
    </view>
    <swiper class="photos-swiper" current="{{currentPhotoIndex}}" bindchange="onPhotoChange" indicator-dots="{{false}}">
      <swiper-item wx:for="{{sharedPhotos}}" wx:key="id">
        <view class="swiper-image-wrapper">
          <image class="swiper-image" src="{{item.url}}" mode="aspectFit"/>
          <view class="photo-info-bar">
            <text class="photo-info-name">{{item.cityName || '城市足迹'}}</text>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <view class="photos-indicator">{{currentPhotoIndex + 1}} / {{sharedPhotos.length}}</view>
  </view>

  <view class="safe-area-bottom"></view>
</view>
