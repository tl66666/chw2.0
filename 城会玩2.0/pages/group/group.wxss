.group-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: linear-gradient(180deg, #FFF7F0 0%, #FFFDF8 52%, #FFF3E8 100%);
}

.hero {
  position: relative;
  min-height: 196rpx;
  padding: 48rpx 32rpx 40rpx;
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  box-sizing: border-box;
  overflow: hidden;
  color: #593D42;
  background: #FFF3E0;
}

.hero-copy,
.hero-stamp {
  position: relative;
  z-index: 1;
}

.hero-background {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: auto;
  width: 56%;
  height: 100%;
  object-fit: cover;
  object-position: right center;
}

.hero-copy {
  max-width: 470rpx;
}

.hero-stamp {
  display: none;
}

.hero-kicker {
  display: block;
  font-size: 22rpx;
  opacity: 0.82;
  letter-spacing: 1rpx;
}

.hero-title {
  display: block;
  margin-top: 8rpx;
  font-size: 50rpx;
  font-weight: 900;
  line-height: 1.1;
}

.hero-desc {
  display: block;
  max-width: 500rpx;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.55;
  opacity: 0.9;
}

.hero-stamp {
  width: 116rpx;
  height: 116rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #593D42;
  font-size: 46rpx;
  font-weight: 900;
  background: rgba(255, 250, 241, 0.72);
  border: 1rpx solid rgba(89, 61, 66, 0.28);
}

.loading-section {
  margin: 24rpx 24rpx 0;
  min-height: 520rpx;
  border-radius: 28rpx;
  background: rgba(255,255,255,0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: 0 14rpx 36rpx rgba(58,42,34,0.08);
}

.empty-section {
  margin: 24rpx 24rpx 0;
  min-height: 480rpx;
  border-radius: 28rpx;
  background: rgba(255,255,255,0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: 0 14rpx 36rpx rgba(58,42,34,0.08);
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

.loading-spinner {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 5rpx solid #F0E4DC;
  border-top-color: #D66F58;
  animation: spin 1s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #8A786E;
}

.group-photo-error {
  margin: 0 0 18rpx;
  padding: 18rpx 20rpx;
  border-left: 5rpx solid #B65E4A;
  background: #F8ECE7;
  color: #75473D;
  font-size: 24rpx;
  line-height: 1.55;
}

.group-load-warning {
  margin: 20rpx 24rpx 0;
  padding: 16rpx 18rpx;
  color: #75473D;
  background: #F8ECE7;
  border-left: 4rpx solid #B65E4A;
  font-size: 23rpx;
  line-height: 1.55;
}

.empty-warning {
  align-self: stretch;
  margin: 0 0 22rpx;
  text-align: left;
}

/* 群组页收口为旅行档案纸张风格，避免横幅与功能区互相抢色。 */
.group-page {
  background: #F5F3EE;
  font-family: 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.hero {
  min-height: 206rpx;
  padding: 42rpx 28rpx 34rpx;
  background: #F7F1E7;
  border-bottom: 1rpx solid rgba(63, 55, 50, 0.12);
}

.hero-stamp {
  display: none;
}

.hero-kicker {
  color: #8B7368;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  opacity: 1;
}

.hero-title,
.section-title,
.group-name,
.modal-title {
  font-family: 'Songti SC', 'STSong', 'Noto Serif CJK SC', serif;
  font-weight: 600;
}

.hero-title {
  margin-top: 6rpx;
  color: #3F3732;
  font-size: 46rpx;
}

.hero-desc {
  max-width: 420rpx;
  color: #6E6159;
  font-size: 23rpx;
  opacity: 1;
}

.loading-section,
.empty-section {
  margin-top: 18rpx;
  border: 1rpx solid rgba(63, 55, 50, 0.12);
  border-radius: 10rpx;
  box-shadow: none;
}

.loading-spinner {
  width: 44rpx;
  height: 44rpx;
  border-color: #F1E2DA;
  border-top-color: #B65E4A;
}

.loading-text {
  color: #80746B;
  font-size: 23rpx;
}

.group-card,
.section-card,
.squad-map-card,
.action-section {
  border: 1rpx solid rgba(63, 55, 50, 0.10);
  border-radius: 10rpx;
  box-shadow: none;
}

.group-card {
  margin-top: -16rpx;
  background: #FFFEFB;
}

.owner-badge,
.owner-badge.member {
  border-radius: 4rpx;
  background: #B65E4A;
  box-shadow: none;
}

.group-card,
.section-card,
.squad-map-card,
.stats-grid,
.action-section {
  margin-left: 24rpx;
  margin-right: 24rpx;
}

.group-card {
  margin-top: -12rpx;
  padding: 24rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: #FFFEFB;
  box-shadow: none;
}

.group-name {
  display: block;
  font-size: 38rpx;
  color: #3F3732;
  font-weight: 600;
}

.group-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8A786E;
}

.group-sync-state {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #C85D4C;
}

.owner-badge {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 4rpx;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
  background: #B65E4A;
}

.owner-badge.member {
  background: #7B98A6;
}

.squad-map-card {
  margin-top: 22rpx;
  padding: 26rpx;
  border-radius: 30rpx;
  overflow: hidden;
  position: relative;
  background:
    radial-gradient(circle at 88% 12%, rgba(214,111,88,0.16), transparent 30%),
    radial-gradient(circle at 12% 88%, rgba(212,165,116,0.22), transparent 34%),
    #FFFFFF;
  box-shadow: 0 12rpx 34rpx rgba(58,42,34,0.08);
}

.squad-map-card::after {
  content: '';
  position: absolute;
  right: -38rpx;
  bottom: -46rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  border: 22rpx solid rgba(214,111,88,0.08);
}

.squad-map-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  margin-bottom: 18rpx;
}

.map-score {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #D66F58, #D99E78);
  box-shadow: 0 12rpx 26rpx rgba(214,111,88,0.22);
}

.stats-grid {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.squad-map-card .stats-grid {
  margin-left: 0;
  margin-right: 0;
  margin-top: 0;
}

.stat-card {
  min-height: 126rpx;
  border-radius: 22rpx;
  padding: 18rpx 8rpx;
  text-align: center;
  background: rgba(255,255,255,0.88);
  box-shadow: 0 8rpx 24rpx rgba(58,42,34,0.06);
  box-sizing: border-box;
}

.stat-number {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
  color: #D66F58;
  line-height: 1.15;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #8A786E;
}

.section-card {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: rgba(255,255,255,0.9);
  box-shadow: 0 10rpx 28rpx rgba(58,42,34,0.06);
}

.section-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  font-size: 31rpx;
  color: #3F3732;
  font-weight: 900;
}

.section-subtitle {
  display: block;
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #9B8E86;
}

.section-more {
  flex-shrink: 0;
  color: #D66F58;
  font-size: 24rpx;
  font-weight: 800;
}

.photo-header-actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.city-scroll {
  width: 100%;
  white-space: nowrap;
}

.city-chip {
  display: inline-flex;
  flex-direction: column;
  justify-content: center;
  min-width: 160rpx;
  height: 92rpx;
  margin-right: 14rpx;
  padding: 0 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #FFF0EA, #FFF6EE);
  border: 1rpx solid rgba(214,111,88,0.08);
}

.city-name {
  font-size: 27rpx;
  color: #3F3732;
  font-weight: 900;
}

.city-meta {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8A786E;
}

.plan-section {
  background: linear-gradient(150deg, #FFFFFF, #FFF9F2);
}

.plan-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.plan-item {
  display: flex;
  gap: 16rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #FFF8F1;
}

.plan-copy {
  flex: 1;
  min-width: 0;
}

.plan-title,
.plan-meta,
.plan-note,
.plan-author {
  display: block;
}

.plan-title {
  color: #3F3732;
  font-size: 27rpx;
  font-weight: 900;
}

.plan-meta {
  margin-top: 6rpx;
  color: #C86B58;
  font-size: 22rpx;
  line-height: 1.4;
}

.plan-note {
  margin-top: 6rpx;
  color: #75655D;
  font-size: 22rpx;
  line-height: 1.45;
}

.plan-author {
  margin-top: 8rpx;
  color: #9B8E86;
  font-size: 20rpx;
}

.plan-actions {
  width: 86rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  gap: 10rpx;
}

.plan-vote {
  min-height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #B7675B;
  font-size: 21rpx;
  font-weight: 900;
  background: #FFFFFF;
  border: 1rpx solid rgba(214,111,88,0.18);
}

.plan-vote.voted {
  color: #FFFFFF;
  background: #D66F58;
  border-color: #D66F58;
}

.plan-vote-count {
  margin-top: 1rpx;
  font-size: 20rpx;
}

.plan-delete {
  padding: 5rpx 0;
  text-align: center;
  color: #A99890;
  font-size: 19rpx;
}

.featured-section {
  background: linear-gradient(145deg, #FFF3E8, #FFFFFF 64%, #FFF7EE);
}

.featured-count {
  color: #B7675B;
  font-size: 22rpx;
  font-weight: 800;
}

.featured-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.featured-photo {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 18rpx;
  background: #F1E8E0;
}

.featured-photo-img {
  width: 100%;
  height: 100%;
}

.featured-photo-caption {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 22rpx 10rpx 9rpx;
  color: #FFFFFF;
  font-size: 19rpx;
  font-weight: 800;
  background: linear-gradient(180deg, transparent, rgba(0,0,0,0.58));
}

.photo-city-scroll {
  width: 100%;
  white-space: nowrap;
  margin: -2rpx 0 16rpx;
}

.photo-city-filters {
  display: flex;
  gap: 10rpx;
}

.photo-city-filter {
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #8A786E;
  font-size: 21rpx;
  background: #FFF8F1;
  border: 1rpx solid rgba(214,111,88,0.1);
}

.photo-city-filter.active {
  color: #FFFFFF;
  background: #D66F58;
}

.photos-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.photo-archives {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.archive-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.archive-date {
  color: #3F3732;
  font-size: 26rpx;
  font-weight: 900;
}

.archive-count {
  color: #9B8E86;
  font-size: 20rpx;
}

.photo-item {
  position: relative;
  aspect-ratio: 1;
  border-radius: 18rpx;
  overflow: hidden;
  background: #F1E8E0;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-caption {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 22rpx 10rpx 10rpx;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  background: linear-gradient(180deg, transparent, rgba(0,0,0,0.58));
}

.photo-comment-count {
  position: absolute;
  z-index: 2;
  right: 8rpx;
  bottom: 46rpx;
  max-width: calc(100% - 16rpx);
  padding: 4rpx 9rpx;
  overflow: hidden;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
  border-radius: 999rpx;
  background: rgba(54, 48, 42, 0.68);
}

.featured-badge,
.feature-toggle {
  position: absolute;
  z-index: 2;
  border-radius: 999rpx;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 800;
}

.featured-badge {
  top: 8rpx;
  left: 8rpx;
  padding: 4rpx 9rpx;
  background: #D66F58;
}

.feature-toggle {
  top: 8rpx;
  right: 8rpx;
  padding: 5rpx 10rpx;
  background: rgba(46, 62, 56, 0.7);
}

.empty-inline {
  padding: 34rpx 20rpx;
  border-radius: 20rpx;
  text-align: center;
  color: #A99890;
  font-size: 25rpx;
  line-height: 1.6;
  background: #FFF8F1;
}

.activity-list,
.member-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.activity-item,
.member-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #FFF8F1;
}

.activity-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #D99E78;
  flex-shrink: 0;
}

.activity-dot.photo {
  background: #D66F58;
}

.activity-copy {
  flex: 1;
  min-width: 0;
}

.activity-title {
  display: block;
  font-size: 25rpx;
  color: #4A403A;
  font-weight: 700;
}

.activity-time {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #A99890;
}

.rank-badge {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 900;
  background: #D66F58;
}

.member-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #F1E8E0;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.member-name {
  font-size: 28rpx;
  color: #3F3732;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-tag {
  flex-shrink: 0;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  background: #D66F58;
  color: #FFFFFF;
  font-size: 18rpx;
}

.member-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8A786E;
}

.creator-item {
  background: linear-gradient(135deg, #FFF0EA, #F7FBF8);
}

.action-section {
  margin-top: 24rpx;
  display: flex;
  gap: 20rpx;
}

.invite-btn {
  flex: 1;
}

.leave-btn {
  flex: 1;
}

.action-btn,
.btn-primary,
.btn-secondary,
.modal-btn {
  min-height: 78rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
  border: none;
  box-sizing: border-box;
}

.action-btn::after,
.modal-btn::after {
  border: none;
}

.invite-btn,
.btn-primary,
.modal-btn.confirm {
  color: #FFFFFF;
  background: linear-gradient(135deg, #D66F58, #B9574D);
}

.leave-btn {
  color: #C85D4C;
  background: #FFFFFF;
}

.empty-illustration {
  width: 280rpx;
  height: 280rpx;
  border-radius: 24rpx;
  margin-bottom: 8rpx;
}

.empty-symbol {
  width: 132rpx;
  height: 132rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #D66F58;
  font-size: 54rpx;
  font-weight: 900;
  background: #FFF0EA;
}

.empty-title {
  display: block;
  margin-top: 24rpx;
  font-size: 36rpx;
  color: #3F3732;
  font-weight: 900;
}

.empty-desc {
  display: block;
  width: 560rpx;
  margin-top: 12rpx;
  color: #8A786E;
  font-size: 25rpx;
  line-height: 1.65;
}

.action-buttons {
  width: 560rpx;
  margin-top: 34rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.btn-secondary {
  color: #D66F58;
  border: 2rpx solid #D66F58;
  background: #FFFFFF;
}

.modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  padding: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(40, 32, 28, 0.55);
  box-sizing: border-box;
}

.modal-content {
  width: 100%;
  max-width: 620rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #FFFFFF;
}

.modal-header {
  padding: 28rpx 30rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-title {
  font-size: 32rpx;
  color: #3F3732;
  font-weight: 900;
}

.modal-close,
.photos-modal-close {
  width: 48rpx;
  height: 48rpx;
  position: relative;
}

.modal-close::before,
.modal-close::after,
.photos-modal-close::before,
.photos-modal-close::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 26rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #9B8E86;
}

.photos-modal-close::before,
.photos-modal-close::after {
  background: #FFFFFF;
}

.modal-close::before,
.photos-modal-close::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.modal-close::after,
.photos-modal-close::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.modal-body,
.invite-box {
  padding: 16rpx 30rpx 22rpx;
}

.invite-card {
  padding: 12rpx 30rpx 8rpx;
  text-align: center;
}

.invite-kicker {
  display: block;
  color: #B16D58;
  font-size: 21rpx;
  font-weight: 800;
}

.invite-group-name {
  display: block;
  margin-top: 10rpx;
  color: #3F3732;
  font-size: 36rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.invite-group-type {
  display: block;
  margin-top: 6rpx;
  color: #9B8E86;
  font-size: 23rpx;
}

.invite-code-panel {
  margin-top: 26rpx;
  padding: 20rpx 24rpx 22rpx;
  border-radius: 20rpx;
  background: #FFF5EE;
  border: 1rpx solid rgba(214, 111, 88, 0.18);
}

.invite-code-label {
  display: block;
  color: #9B8E86;
  font-size: 21rpx;
}

.invite-code {
  display: block;
  margin-top: 10rpx;
  color: #D66F58;
  font-family: monospace;
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: 10rpx;
  line-height: 1.1;
}

.invite-steps {
  margin-top: 20rpx;
  text-align: left;
}

.invite-step {
  display: block;
  margin-top: 8rpx;
  color: #75655D;
  font-size: 23rpx;
  line-height: 1.5;
}

.invite-actions {
  padding: 22rpx 30rpx 30rpx;
}

.invite-copy-btn {
  height: 80rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 900;
  background: #D66F58;
}

.invite-copy-btn:active {
  background: #B9574D;
}

.form-label {
  display: block;
  margin: 18rpx 0 12rpx;
  color: #4A403A;
  font-size: 26rpx;
  font-weight: 800;
}

.form-input,
.code-input {
  width: 100%;
  min-height: 90rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #FFF8F1;
  color: #3F3732;
  font-size: 28rpx;
  box-sizing: border-box;
}

.code-input {
  text-align: center;
  letter-spacing: 10rpx;
  font-size: 42rpx;
  color: #D66F58;
  font-weight: 900;
}

.plan-date-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
}

.plan-date-input,
.plan-note-input {
  width: 100%;
  color: #75655D;
  font-size: 24rpx;
  background: #FFF8F1;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.discussion-mask {
  position: fixed;
  z-index: 120;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(35, 29, 25, 0.58);
}

.discussion-panel {
  width: 100%;
  max-height: 88vh;
  padding: 24rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 28rpx 28rpx 0 0;
  background: #FFFDF9;
}

.discussion-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.discussion-title,
.discussion-subtitle {
  display: block;
}

.discussion-title {
  color: #3F3732;
  font-size: 31rpx;
  font-weight: 900;
}

.discussion-subtitle {
  max-width: 560rpx;
  margin-top: 4rpx;
  overflow: hidden;
  color: #9B8E86;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.discussion-close {
  position: relative;
  width: 46rpx;
  height: 46rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #F1E8E0;
}

.discussion-close::before,
.discussion-close::after {
  position: absolute;
  top: 22rpx;
  left: 11rpx;
  width: 24rpx;
  height: 2rpx;
  content: '';
  background: #7F6C62;
}

.discussion-close::before { transform: rotate(45deg); }
.discussion-close::after { transform: rotate(-45deg); }

.discussion-image {
  width: 100%;
  height: 360rpx;
  border-radius: 18rpx;
  background: #F1E8E0;
}

.discussion-composer {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  margin: 18rpx 0;
}

.discussion-input {
  flex: 1;
  min-height: 64rpx;
  max-height: 128rpx;
  padding: 14rpx 16rpx;
  color: #4A403A;
  font-size: 24rpx;
  line-height: 1.4;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #F8F1EB;
}

.discussion-submit {
  min-width: 88rpx;
  min-height: 64rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 23rpx;
  font-weight: 800;
  border-radius: 16rpx;
  background: #D66F58;
}

.discussion-comments {
  max-height: 390rpx;
}

.comment-empty {
  padding: 26rpx 8rpx;
  text-align: center;
  color: #A99890;
  font-size: 23rpx;
}

.comment-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(130, 108, 94, 0.1);
}

.comment-avatar {
  width: 46rpx;
  height: 46rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #F1E8E0;
}

.comment-copy {
  flex: 1;
  min-width: 0;
}

.comment-meta {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.comment-name {
  color: #5A4A42;
  font-size: 22rpx;
  font-weight: 800;
}

.comment-time {
  color: #A99890;
  font-size: 19rpx;
}

.comment-content {
  display: block;
  margin-top: 4rpx;
  color: #5F5149;
  font-size: 23rpx;
  line-height: 1.45;
  word-break: break-all;
}

.comment-delete {
  padding: 4rpx 0 4rpx 10rpx;
  color: #B7675B;
  font-size: 19rpx;
  flex-shrink: 0;
}

.plan-date-input {
  min-height: 74rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
}

.plan-note-input {
  min-height: 138rpx;
  padding: 16rpx;
  line-height: 1.45;
}

.type-selector {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.type-option {
  height: 82rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8A786E;
  font-size: 26rpx;
  font-weight: 800;
  background: #FFF8F1;
}

.type-option.active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #D66F58, #D99E78);
}

.modal-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 12rpx 30rpx 30rpx;
}

.modal-btn.cancel {
  color: #7C6C64;
  background: #F5EFE9;
}

.invite-box {
  text-align: center;
}

.invite-code {
  display: block;
  font-size: 62rpx;
  color: #D66F58;
  font-weight: 900;
  letter-spacing: 10rpx;
}

.invite-hint {
  display: block;
  margin-top: 12rpx;
  color: #8A786E;
  font-size: 24rpx;
}

.photos-modal {
  position: fixed;
  inset: 0;
  z-index: 2000;
  display: flex;
  flex-direction: column;
  background: #101010;
}

.photos-modal-header {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.photos-modal-title {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 900;
}

.photos-swiper {
  flex: 1;
}

.swiper-image-wrapper {
  height: 100%;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.swiper-image {
  max-width: 100%;
  max-height: 72%;
}

.photo-info-bar {
  margin-top: 24rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255,255,255,0.12);
}

.photo-info-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.photo-info-name,
.photos-indicator {
  color: #FFFFFF;
  font-size: 26rpx;
}

.photos-indicator {
  padding: 24rpx;
  text-align: center;
  opacity: 0.78;
}
