<view class="page {{screenShake ? 'shake' : ''}}">
  <!-- 背景层 -->
  <view class="warm-bg"></view>

  <!-- 全屏光效 -->
  <view class="fullscreen-glow {{showGlow ? 'show' : ''}} rarity-{{rarity}}"></view>

  <!-- 粒子特效 SSR -->
  <view class="particles-ssr {{showParticles && rarity === 'SSR' ? 'show' : ''}}">
    <view class="particle-gold p1"></view>
    <view class="particle-gold p2"></view>
    <view class="particle-gold p3"></view>
    <view class="particle-gold p4"></view>
    <view class="particle-gold p5"></view>
    <view class="particle-gold p6"></view>
    <view class="particle-gold p7"></view>
    <view class="particle-gold p8"></view>
    <view class="particle-gold p9"></view>
    <view class="particle-gold p10"></view>
    <view class="particle-gold p11"></view>
    <view class="particle-gold p12"></view>
  </view>

  <!-- 粒子特效 UR -->
  <view class="particles-ur {{showParticles && rarity === 'UR' ? 'show' : ''}}">
    <view class="particle-rainbow p1"></view>
    <view class="particle-rainbow p2"></view>
    <view class="particle-rainbow p3"></view>
    <view class="particle-rainbow p4"></view>
    <view class="particle-rainbow p5"></view>
    <view class="particle-rainbow p6"></view>
    <view class="particle-rainbow p7"></view>
    <view class="particle-rainbow p8"></view>
    <view class="particle-rainbow p9"></view>
    <view class="particle-rainbow p10"></view>
    <view class="particle-rainbow p11"></view>
    <view class="particle-rainbow p12"></view>
    <view class="particle-rainbow p13"></view>
    <view class="particle-rainbow p14"></view>
    <view class="particle-rainbow p15"></view>
  </view>

  <!-- 光环 -->
  <view class="halo-ring {{showGlow ? 'show' : ''}} rarity-{{rarity}}"></view>
  <view class="halo-ring-inner {{showGlow ? 'show' : ''}} rarity-{{rarity}}"></view>

  <!-- 阶段1：卡背展示 -->
  <view class="card-container {{phase === 1 ? 'show' : 'hide'}}">
    <view class="card-back">
      <view class="card-back-pattern"></view>
      <view class="card-back-logo">?</view>
      <view class="card-back-glow"></view>
    </view>
    <view class="phase-text">{{unlockText}}</view>
  </view>

  <!-- 阶段2：光芒爆发 -->
  <view class="glow-burst {{phase === 2 ? 'show' : ''}} rarity-{{rarity}}">
    <view class="burst-core"></view>
    <view class="burst-ray r1"></view>
    <view class="burst-ray r2"></view>
    <view class="burst-ray r3"></view>
    <view class="burst-ray r4"></view>
    <view class="burst-ray r5"></view>
    <view class="burst-ray r6"></view>
    <view class="burst-ray r7"></view>
    <view class="burst-ray r8"></view>
  </view>

  <!-- 阶段3：卡片翻转展示 -->
  <view class="card-reveal-container {{phase === 3 ? 'show' : ''}}">
    <view class="card-wrapper {{cardFlipped ? 'flipped' : ''}}">
      <view class="card-face card-front">
        <view class="card-back-pattern"></view>
        <view class="card-back-logo">?</view>
      </view>
      <view class="card-face card-back-side">
        <view class="character-card rarity-{{rarity}}">
          <view class="card-frame">
            <view class="card-frame-corner tl"></view>
            <view class="card-frame-corner tr"></view>
            <view class="card-frame-corner bl"></view>
            <view class="card-frame-corner br"></view>
          </view>
          <image class="character-img" src="{{cardImage}}" mode="aspectFill"/>
          <view class="card-overlay"></view>
          <view class="rarity-badge {{showRarityBadge ? 'show' : ''}}" style="background:{{rarityColor}}">{{rarity}}</view>
          <view class="character-name {{showRarityBadge ? 'show' : ''}}">{{character.name}}</view>
          <view class="character-title {{showRarityBadge ? 'show' : ''}}">「{{character.title}}」</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 阶段4+5：结果展示 -->
  <view class="result-area {{phase >= 4 ? 'show' : ''}}">
    <!-- 卡片区域 -->
    <view class="card-section">
      <view class="showcase-card rarity-{{rarity}}">
        <view class="showcase-glow rarity-{{rarity}}"></view>
        <view class="showcase-img-wrapper">
          <image class="showcase-img" src="{{cardImage}}" mode="aspectFit" lazy-load/>
        </view>
        <view class="showcase-overlay"></view>
        <view class="showcase-rarity-badge {{showRarityBadge ? 'show' : ''}}" style="background:{{rarityColor}}">{{rarity}}</view>
        <!-- 卡片底部信息 -->
        <view class="showcase-card-info">
          <view class="showcase-name {{showRarityBadge ? 'show' : ''}}">{{character.name}}</view>
          <view class="showcase-title {{showRarityBadge ? 'show' : ''}}">「{{character.title}}」</view>
        </view>
      </view>
    </view>

    <!-- 解锁提示 -->
    <view class="unlock-msg {{phase >= 4 ? 'show' : ''}}">{{unlockText}}</view>

    <!-- 属性区域 -->
    <view class="attrs-section {{phase >= 5 ? 'show' : ''}}">
      <view class="attr-row">
        <view class="attr-icon-wrap">
          <view class="attr-icon icon-culture"></view>
          <text class="attr-label">文化</text>
        </view>
        <view class="attr-bar-bg">
          <view class="attr-fill culture" style="width:{{character.attributes.culture}}%"></view>
        </view>
        <text class="attr-value">{{character.attributes.culture}}</text>
      </view>
      <view class="attr-row">
        <view class="attr-icon-wrap">
          <view class="attr-icon icon-fashion"></view>
          <text class="attr-label">时尚</text>
        </view>
        <view class="attr-bar-bg">
          <view class="attr-fill fashion" style="width:{{character.attributes.fashion}}%"></view>
        </view>
        <text class="attr-value">{{character.attributes.fashion}}</text>
      </view>
      <view class="attr-row">
        <view class="attr-icon-wrap">
          <view class="attr-icon icon-food"></view>
          <text class="attr-label">美食</text>
        </view>
        <view class="attr-bar-bg">
          <view class="attr-fill food" style="width:{{character.attributes.food}}%"></view>
        </view>
        <text class="attr-value">{{character.attributes.food}}</text>
      </view>
      <view class="attr-row">
        <view class="attr-icon-wrap">
          <view class="attr-icon icon-history"></view>
          <text class="attr-label">历史</text>
        </view>
        <view class="attr-bar-bg">
          <view class="attr-fill history" style="width:{{character.attributes.history}}%"></view>
        </view>
        <text class="attr-value">{{character.attributes.history}}</text>
      </view>
    </view>

    <!-- 技能 -->
    <view class="skill-section {{phase >= 5 ? 'show' : ''}}">
      <view class="skill-icon icon-skill"></view>
      <text class="skill-name">{{character.skill}}</text>
    </view>

    <!-- 引言 -->
    <view class="quote-section {{phase >= 5 ? 'show' : ''}}">
      <text class="quote-mark">"</text>
      <text class="quote-text">{{character.quote}}</text>
      <text class="quote-mark">"</text>
    </view>

    <!-- 底部按钮 -->
    <view class="actions {{phase >= 5 ? 'show' : ''}}">
      <view class="btn btn-primary" bindtap="goToCards">查看角色卡</view>
      <view class="btn btn-ghost" bindtap="backToMap">继续探索</view>
    </view>
  </view>

  <!-- 成就解锁弹窗 -->
  <view class="achievement-popup {{showAchievementPopup ? 'show' : ''}}">
    <view class="achievement-popup-bg" bindtap="closeAchievementPopup"></view>
    <view class="achievement-popup-content">
      <view class="achievement-popup-icon">
        <text>🏆</text>
      </view>
      <text class="achievement-popup-title">成就解锁</text>
      <text class="achievement-popup-name">{{newAchievement.title}}</text>
      <view class="achievement-popup-reward">
        <text>+{{newAchievement.reward}} 积分</text>
      </view>
      <view class="achievement-popup-btn" bindtap="closeAchievementPopup">太棒了</view>
    </view>
  </view>
</view>
