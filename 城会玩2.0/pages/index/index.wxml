<view class="container">
  <!-- 顶部欢迎区域 -->
  <view class="welcome-section">
    <image class="welcome-banner" src="/images/headers/map-hero-final-v2.png" mode="aspectFill"/>
    <view class="welcome-overlay"></view>
    <view class="welcome-text">
      <text class="welcome-title">探索中国</text>
      <text class="welcome-subtitle">点亮城市，收集旅行角色卡</text>
    </view>
  </view>

  <!-- 统计栏 -->
  <view class="stats-bar">
    <view class="stat-card">
      <text class="stat-number">{{visitedCount}}</text>
      <text class="stat-label">已点亮城市</text>
    </view>
    <view class="stat-card">
      <text class="stat-number">{{visitedProvinces}}</text>
      <text class="stat-label">已点亮省份</text>
    </view>
    <view class="stat-card">
      <text class="stat-number">{{photoCount}}</text>
      <text class="stat-label">旅行照片</text>
    </view>
  </view>

  <!-- 中国地图区域 -->
  <view class="map-section">
    <view class="section-header">
      <text class="section-title">中国地图</text>
      <text class="section-subtitle">{{selectedProvince ? '选中：' + selectedProvince : '点击标记探索省份'}}</text>
    </view>

    <!-- 城市搜索框 -->
    <view class="search-bar">
      <view class="search-input-wrap">
        <text class="search-icon">🔍</text>
        <input class="search-input" placeholder="搜索城市名称..." value="{{searchKeyword}}" bindinput="onSearchInput" bindfocus="onSearchFocus" bindblur="onSearchBlur" confirm-type="search"/>
        <text class="search-clear" wx:if="{{searchKeyword}}" bindtap="onSearchClear">✕</text>
      </view>
      <!-- 搜索结果面板 -->
      <view class="search-results-panel" wx:if="{{showSearchPanel && searchResults.length > 0}}">
        <view class="search-result-item" wx:for="{{searchResults}}" wx:key="id" bindtap="onSearchResultTap" data-cityid="{{item.id}}">
          <view class="result-info">
            <view class="result-name-row">
              <text class="result-name">{{item.name}}</text>
              <text class="result-visited-tag" wx:if="{{item.visited}}">✓ 已打卡</text>
            </view>
            <text class="result-province">{{item.provinceName}}</text>
          </view>
          <text class="result-landmark" wx:if="{{item.landmark}}">{{item.landmark}}</text>
        </view>
      </view>
      <view class="search-results-panel search-no-result" wx:if="{{showSearchPanel && searchResults.length === 0 && searchKeyword}}">
        <text class="no-result-text">未找到"{{searchKeyword}}"相关城市</text>
      </view>
    </view>

    <!-- 地图容器 -->
    <view class="map-wrapper">
      <map
        id="chinaMap"
        class="map-component"
        longitude="105"
        latitude="38"
        scale="4"
        show-location="{{false}}"
        markers="{{mapMarkers}}"
        bindmarkertap="onMarkerTap"
      />
    </view>

    <!-- 图例 + 已点亮省份 -->
  <view class="map-info-row">
    <view class="map-legend">
      <view class="legend-item">
        <view class="legend-dot visited"></view>
        <text class="legend-text">已点亮</text>
      </view>
      <view class="legend-item">
        <view class="legend-dot unvisited"></view>
        <text class="legend-text">未探索</text>
      </view>
    </view>
    <text class="province-summary" wx:if="{{visitedProvinces > 0}}">已点亮 {{visitedProvinces}} 个省份</text>
  </view>

  <!-- 已点亮省份标签 -->
  <view class="visited-provinces-bar" wx:if="{{provinceList.length > 0}}">
    <scroll-view scroll-x class="provinces-scroll" enhanced show-scrollbar="{{false}}">
      <view class="provinces-row">
        <block wx:for="{{provinceList}}" wx:key="id">
          <view class="province-tag {{item.visited ? 'tag-visited' : 'tag-normal'}}" wx:if="{{item.visited}}" bindtap="onProvinceTagTap" data-provinceid="{{item.id}}">
            <text class="tag-check">✓</text>
            <text>{{item.name}}</text>
            <text class="tag-count">{{item.hasProvinceRecord ? '省份足迹' : item.visitedCities + '/' + item.totalCities}}</text>
          </view>
        </block>
        <view class="province-tag tag-hint" wx:if="{{visitedProvinces === 0}}">
          <text>点击地图上的标记开始探索</text>
        </view>
      </view>
    </scroll-view>
  </view>
  </view>

  <!-- 探索进度 -->
  <view class="progress-section" wx:if="{{visitedCount > 0}}">
    <view class="progress-header">
      <text class="progress-title">探索进度</text>
      <text class="progress-percent">{{completionRate}}%</text>
    </view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{completionRate}}%"></view>
    </view>
    <text class="progress-desc">已探索 {{visitedCount}}/{{totalCities}} 座城市</text>
  </view>

  <!-- 最近记录 — 按省份展示 -->
  <view class="recent-section" wx:if="{{recentCities.length > 0}}">
    <view class="section-header">
      <text class="section-title">最近记录</text>
      <text class="section-more" bindtap="goToAlbum">查看全部</text>
    </view>
    <scroll-view scroll-x class="recent-scroll" enhanced show-scrollbar="{{false}}">
      <view class="recent-list">
        <view
          wx:for="{{recentCities}}"
          wx:key="id"
          class="recent-item"
          bindtap="onProvinceTagTap"
          data-provinceid="{{item.id}}"
        >
          <view class="recent-image-wrapper">
            <image class="recent-image" src="{{item.photoUrl}}" mode="aspectFill" wx:if="{{item.photoUrl}}" binderror="onRecentImageError" data-index="{{index}}"/>
            <view class="recent-placeholder" wx:else>
              <text class="placeholder-text">{{item.name}}</text>
            </view>
          </view>
          <view class="recent-info">
            <text class="recent-name">{{item.name}}</text>
            <text class="recent-landmark" wx:if="{{item.provinceName}}">{{item.provinceName}}</text>
            <text class="recent-date">{{item.visitDate}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 下一站推荐 -->
  <view class="recommend-section" wx:if="{{recommendation}}">
    <view class="recommend-header">
      <text class="recommend-title">下一站推荐</text>
      <view class="recommend-refresh" bindtap="refreshRecommendation">
        <text class="refresh-icon">↻</text>
        <text class="refresh-text">换一个</text>
      </view>
    </view>
    <view class="recommend-card" bindtap="onRecommendTap">
      <view class="recommend-info">
        <view class="recommend-city-row">
          <text class="recommend-city">{{recommendation.name}}</text>
          <text class="recommend-province">{{recommendation.provinceName}}</text>
        </view>
        <text class="recommend-intro">{{recommendation.intro}}</text>
        <text class="recommend-season" wx:if="{{recommendation.bestSeason}}">最佳季节：{{recommendation.bestSeason}}</text>
      </view>
      <view class="recommend-arrow">
        <text>›</text>
      </view>
    </view>
  </view>
</view>
