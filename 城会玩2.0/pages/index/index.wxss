page {
  --bg-primary: #F8F5F2;
  --bg-card: #FFFFFF;
  --pink-primary: #D4A574;
  --pink-dark: #B8935F;
  --pink-light: #E8D5C4;
  --text-primary: #2C2C2C;
  --text-secondary: #5A5A5A;
  --text-muted: #8A8A8A;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.container {
  padding: 32rpx;
  padding-bottom: 48rpx;
  background: var(--bg-primary);
  min-height: 100vh;
}

/* 欢迎区域 */
.welcome-section {
  margin-bottom: 32rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.welcome-title {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.welcome-subtitle {
  font-size: 26rpx;
  color: var(--text-muted);
  font-weight: 400;
}

/* 统计栏 */
.stats-bar {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32rpx;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.stat-number {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--pink-primary);
  display: block;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 地图区域 */
.map-section {
  margin-bottom: 32rpx;
}

.section-header {
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-subtitle {
  font-size: 22rpx;
  color: var(--text-muted);
}

.section-more {
  font-size: 24rpx;
  color: var(--pink-primary);
}

/* 地图容器 */
.map-wrapper {
  position: relative;
  width: 100%;
  height: 500rpx;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

/* 搜索栏 */
.search-bar {
  position: relative;
  margin-bottom: 16rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  height: 72rpx;
}

.search-clear {
  font-size: 28rpx;
  color: var(--text-muted);
  padding: 8rpx;
}

.search-results-panel {
  position: absolute;
  top: 80rpx;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  max-height: 480rpx;
  overflow-y: auto;
  z-index: 50;
}

.search-result-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.search-result-item:last-child {
  border-bottom: none;
}

.search-result-item:active {
  background: rgba(212, 165, 116, 0.05);
}

.result-info {
  display: flex;
  flex-direction: column;
}

.result-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.result-province {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.result-landmark {
  font-size: 22rpx;
  color: var(--text-secondary);
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-no-result {
  padding: 32rpx;
  text-align: center;
}

.no-result-text {
  font-size: 26rpx;
  color: var(--text-muted);
}

.result-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.result-visited-tag {
  font-size: 20rpx;
  color: #4ECDC4;
  background: rgba(78, 205, 196, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

/* 原生地图组件 */
.map-component {
  width: 100%;
  height: 100%;
}

/* 图例 + 省份统计 */
.map-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding: 0 8rpx;
}

.map-legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-top: 0;
}

.province-summary {
  font-size: 22rpx;
  color: var(--pink-primary);
  font-weight: 500;
}

/* 已点亮省份标签栏 */
.visited-provinces-bar {
  margin-top: 16rpx;
  padding: 12rpx 0;
}

.provinces-scroll {
  width: 100%;
}

.provinces-row {
  display: flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.province-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  white-space: nowrap;
  flex-shrink: 0;
  transition: all 0.2s;
}

.tag-visited {
  background: linear-gradient(135deg, #FDE8ED, #FCE4EC);
  border: 1rpx solid #F4A6B5;
  color: #D4687C;
}

.tag-normal {
  background: #F5F5F5;
  border: 1rpx solid #E0E0E0;
  color: #999;
}

.tag-hint {
  background: transparent;
  border: 1rpx dashed #D0D0D0;
  color: #B0B0B0;
  font-size: 22rpx;
}

.tag-check {
  font-size: 20rpx;
  color: #E98296;
  font-weight: 700;
}

.tag-count {
  font-size: 18rpx;
  color: #C4909C;
  background: rgba(244, 166, 181, 0.15);
  padding: 2rpx 8rpx;
  border-radius: 12rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-dot.visited {
  background: var(--pink-primary);
  box-shadow: 0 0 8rpx rgba(212, 165, 116, 0.4);
}

.legend-dot.unvisited {
  background: #D0D0D0;
}

.legend-text {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 探索进度 */
.progress-section {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.progress-percent {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--pink-primary);
}

.progress-bar {
  height: 8rpx;
  background: #F0F0F0;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--pink-light), var(--pink-primary));
  border-radius: 4rpx;
  transition: width 1s ease;
}

.progress-desc {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 最近记录 */
.recent-section {
  margin-bottom: 32rpx;
}

.recent-scroll {
  width: 100%;
}

.recent-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx;
}

.recent-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.recent-image-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.recent-image {
  width: 100%;
  height: 100%;
}

.recent-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #E8D5C4, #F0E6D8);
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-text {
  font-size: 24rpx;
  color: var(--text-muted);
}

.recent-info {
  text-align: center;
}

.recent-name {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 2rpx;
}

.recent-landmark {
  font-size: 18rpx;
  color: #B0A090;
  display: block;
  margin-bottom: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 140rpx;
}

.recent-date {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 快捷操作 */
/* 下一站推荐 */
.recommend-section {
  margin-bottom: 24rpx;
}

.recommend-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.recommend-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.recommend-refresh {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  background: rgba(102, 126, 234, 0.08);
  border-radius: 24rpx;
}

.recommend-refresh:active {
  background: rgba(102, 126, 234, 0.15);
}

.refresh-icon {
  font-size: 26rpx;
  color: #667eea;
}

.refresh-text {
  font-size: 24rpx;
  color: #667eea;
}

.recommend-card {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  border-left: 6rpx solid #667eea;
}

.recommend-card:active {
  transform: scale(0.98);
}

.recommend-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.recommend-city-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.recommend-city {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.recommend-province {
  font-size: 24rpx;
  color: var(--text-muted);
}

.recommend-intro {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.recommend-season {
  font-size: 22rpx;
  color: #667eea;
  margin-top: 4rpx;
}

.recommend-arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.recommend-arrow text {
  font-size: 36rpx;
  color: var(--text-muted);
}

/* 分享按钮 */
.share-section {
  margin-bottom: 40rpx;
}

.share-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, var(--pink-primary), var(--pink-dark));
  color: #fff;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.3);
}

.share-btn::after {
  border: none;
}

.share-btn:active {
  transform: scale(0.98);
}

.share-icon {
  font-size: 28rpx;
}

/* 分享按钮已移除 */
