page {
  --bg-primary: #F8F5F2;
  --bg-card: #FFFFFF;
  --gold-primary: #D4A574;
  --gold-dark: #B8935F;
  --gold-light: #E8D5C4;
  --text-primary: #2C2C2C;
  --text-secondary: #5A5A5A;
  --text-muted: #8A8A8A;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.container {
  padding: 20rpx;
  padding-bottom: 32rpx;
  background: var(--bg-primary);
  min-height: 100vh;
}

/* 头部卡片 */
.header-card {
  margin-bottom: 24rpx;
}

.city-hero {
  position: relative;
  width: 100%;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: linear-gradient(135deg, #E8D5C4 0%, #D4A574 50%, #C9B8A8 100%);
}

.city-image {
  width: 100%;
  display: block;
}

.city-gradient {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #E8D5C4 0%, #D4A574 50%, #C9B8A8 100%);
}

.gradient-text {
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 600;
}

.city-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.5) 100%);
}

.city-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 100rpx;
  margin-bottom: 12rpx;
}

.city-badge text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.city-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.city-province {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
  margin-bottom: 6rpx;
}

.city-stats {
  display: flex;
  gap: 12rpx;
}

.city-stat {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 100rpx;
}

/* 快捷操作栏 */
.quick-actions {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 14rpx 16rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  transition: all 0.3s ease;
}

.action-item:active {
  transform: scale(0.95);
}

.action-item.visited .action-icon {
  background: linear-gradient(135deg, #27AE60, #2ECC71);
}

.action-item.visited .action-label {
  color: #27AE60;
}

.action-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--gold-primary), var(--gold-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(212, 165, 116, 0.3);
}

/* 定位图标 */
.icon-pin {
  width: 20rpx;
  height: 20rpx;
  background: #FFFFFF;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  position: relative;
}
.icon-pin::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 8rpx;
  height: 8rpx;
  background: var(--gold-primary);
  border-radius: 50%;
}

/* 相机图标 */
.icon-camera {
  position: relative;
}
.icon-camera-inner {
  width: 28rpx;
  height: 20rpx;
  background: #FFFFFF;
  border-radius: 4rpx;
  position: relative;
}
.icon-camera-inner::before {
  content: '';
  position: absolute;
  top: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 10rpx;
  height: 6rpx;
  background: #FFFFFF;
  border-radius: 2rpx 2rpx 0 0;
}
.icon-camera-inner::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 10rpx;
  height: 10rpx;
  background: var(--gold-primary);
  border-radius: 50%;
}

/* 卡片图标 */
.icon-card {
  position: relative;
}
.icon-card-inner {
  width: 24rpx;
  height: 32rpx;
  background: #FFFFFF;
  border-radius: 4rpx;
  position: relative;
}
.icon-card-inner::before {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 14rpx;
  height: 14rpx;
  background: var(--gold-primary);
  border-radius: 50%;
}
.icon-card-inner::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 2rpx;
  background: var(--gold-primary);
  border-radius: 1rpx;
}

.action-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.action-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.06);
}

.action-danger .action-icon {
  background: linear-gradient(135deg, #E74C3C, #F87171);
}

.action-danger .action-label {
  color: #E74C3C;
}

.icon-remove-text {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

/* 信息卡片通用样式 */
.info-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.card-header {
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.card-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 城市简介 */
.intro-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.intro-header {
  margin-bottom: 8rpx;
}

.intro-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.intro-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 地标推荐 */
.landmark-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.landmark-header {
  margin-bottom: 8rpx;
}

.landmark-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.landmark-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 地标标签 */
.landmark-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.landmark-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  background: rgba(212, 165, 116, 0.1);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--pink-dark);
  border: 1rpx solid rgba(212, 165, 116, 0.15);
}

/* 城市攻略卡片 */
.guide-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  border-left: 4rpx solid #667eea;
}

.guide-header {
  margin-bottom: 12rpx;
}

.guide-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #667eea;
}

.guide-intro {
  margin-bottom: 16rpx;
}

.guide-intro-text {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.7;
}

.guide-info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
}

.guide-info-row:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.guide-info-label {
  flex-shrink: 0;
  width: 120rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.guide-info-value {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

/* 照片墙 */
.photos-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.photos-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.photos-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.photos-count {
  font-size: 22rpx;
  color: var(--text-muted);
}

.photos-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6rpx;
}

.photo-item {
  position: relative;
  aspect-ratio: 1;
  border-radius: var(--radius-sm);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.photo-image {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-status {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  background: rgba(0, 0, 0, 0.48);
  backdrop-filter: blur(6rpx);
  z-index: 8;
}

.photo-status.private {
  background: rgba(212, 165, 116, 0.92);
}

/* 添加照片按钮（醒目样式） */
.add-photo-btn {
  background: linear-gradient(135deg, var(--gold-primary) 0%, var(--gold-dark) 100%);
  border-radius: var(--radius-md);
  padding: 16rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  transition: all 0.3s ease;
}

.add-photo-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(212, 165, 116, 0.2);
}

.add-photo-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-photo-icon {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

.add-photo-text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* 照片分类标签 */
.photo-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.photo-tab {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 0 12rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  box-shadow: var(--shadow-sm);
  transition: all 0.3s;
  height: 64rpx;
  box-sizing: border-box;
}

.photo-tab.active {
  border-color: var(--gold-primary);
  background: linear-gradient(135deg, rgba(212, 165, 116, 0.1) 0%, rgba(212, 165, 116, 0.05) 100%);
}

.tab-icon {
  font-size: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  display: inline-block;
  flex-shrink: 0;
}

.tab-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
  height: 26rpx;
  line-height: 26rpx;
  display: inline-block;
  white-space: nowrap;
}

.photo-tab.active .tab-text {
  color: var(--gold-primary);
  font-weight: 600;
}

.tab-count {
  font-size: 20rpx;
  color: #FFFFFF;
  background: var(--gold-primary);
  padding: 2rpx 10rpx;
  border-radius: 100rpx;
  height: 20rpx;
  line-height: 20rpx;
  display: inline-block;
  flex-shrink: 0;
}

/* 空状态 */
.empty-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.empty-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.empty-icon {
  font-size: 48rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.empty-hint {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 照片删除按钮 */
.photo-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.photo-delete text {
  font-size: 20rpx;
  color: #FFFFFF;
}

/* 备注 */
.note-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

/* 避坑指南卡片 */
.avoid-card {
  border-left: 4rpx solid #4ECDC4;
  background: linear-gradient(135deg, rgba(78, 205, 196, 0.04), var(--bg-card));
}

.avoid-card .note-title {
  color: #2a9d8f;
}

.avoid-card .note-save {
  background: rgba(78, 205, 196, 0.12);
}

.avoid-card .note-save text {
  color: #2a9d8f;
}

.avoid-textarea {
  min-height: 100rpx;
}

.note-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.note-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.note-delete-btn {
  padding: 6rpx 20rpx;
  background: rgba(231, 76, 60, 0.08);
  border-radius: 20rpx;
}

.note-delete-btn text {
  font-size: 22rpx;
  color: #E74C3C;
}

.note-textarea {
  width: 100%;
  height: 100rpx;
  padding: 12rpx;
  background: var(--bg-primary);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  color: var(--text-primary);
  line-height: 1.5;
  box-sizing: border-box;
}

.note-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.note-count {
  font-size: 20rpx;
  color: var(--text-muted);
}

.note-save {
  padding: 8rpx 20rpx;
  background: var(--gold-primary);
  border-radius: var(--radius-sm);
}

.note-save text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.group-footprint-card {
  margin-bottom: 12rpx;
  padding: 20rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF7EF 55%, #F6EFE8 100%);
  border: 1rpx solid rgba(212, 165, 116, 0.22);
  box-shadow: var(--shadow-sm);
}

.group-footprint-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.group-footprint-kicker {
  display: block;
  margin-bottom: 4rpx;
  font-size: 20rpx;
  color: var(--gold-dark);
  font-weight: 700;
  letter-spacing: 1rpx;
}

.group-footprint-title {
  display: block;
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 800;
}

.group-footprint-pill {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(212, 165, 116, 0.14);
  color: var(--gold-dark);
  font-size: 22rpx;
  font-weight: 700;
}

.group-footprint-empty,
.group-footprint-note {
  padding: 18rpx;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.7);
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.group-visitors {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  padding-bottom: 10rpx;
}

.group-visitor {
  min-width: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.group-visitor-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F1ECE7;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(184, 147, 95, 0.18);
}

.group-visitor-name {
  max-width: 104rpx;
  font-size: 20rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.group-photo-strip {
  display: flex;
  gap: 10rpx;
  overflow-x: auto;
  padding-top: 6rpx;
}

.group-photo-item {
  position: relative;
  flex: 0 0 156rpx;
  height: 156rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: #F1ECE7;
  box-shadow: var(--shadow-sm);
}

.group-photo-img {
  width: 100%;
  height: 100%;
  display: block;
}

.group-photo-meta {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 10rpx 8rpx;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.58));
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.photo-status.group {
  background: rgba(120, 182, 166, 0.92);
  color: #FFFFFF;
}

.achievement-popup {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.achievement-popup.show {
  opacity: 1;
  pointer-events: auto;
}

.achievement-popup-bg {
  position: absolute;
  inset: 0;
  background: rgba(34, 26, 22, 0.46);
  backdrop-filter: blur(10rpx);
}

.achievement-popup-content {
  position: relative;
  z-index: 1;
  width: 640rpx;
  max-width: 86vw;
  box-sizing: border-box;
  padding: 38rpx 34rpx 34rpx;
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 88% 18%, rgba(120, 182, 166, 0.24), transparent 28%),
    linear-gradient(135deg, #FFFDF8 0%, #FFF1E8 100%);
  border: 2rpx solid rgba(214, 111, 88, 0.14);
  box-shadow: 0 28rpx 80rpx rgba(58, 42, 34, 0.28);
  transform: scale(0.9) translateY(20rpx);
  transition: transform 0.32s cubic-bezier(0.2, 0.9, 0.2, 1.2);
}

.achievement-popup.show .achievement-popup-content {
  transform: scale(1) translateY(0);
}

.achievement-popup-badge-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.achievement-popup-badge {
  width: 160rpx;
  height: 160rpx;
  border-radius: 36rpx;
  background: #FFFFFF;
  box-shadow: 0 14rpx 32rpx rgba(214, 111, 88, 0.22);
}

.achievement-popup-kicker {
  display: block;
  color: #C9915F;
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.achievement-popup-name {
  display: block;
  margin-top: 8rpx;
  color: #3F3732;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.18;
}

.achievement-popup-desc {
  display: block;
  margin-top: 12rpx;
  color: #8A786E;
  font-size: 25rpx;
  line-height: 1.45;
}

.achievement-popup-reward {
  display: inline-flex;
  margin-top: 22rpx;
