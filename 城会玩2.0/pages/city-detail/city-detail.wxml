<view class="container">
  <!-- 头部区域：城市大图 + 核心信息 -->
  <view class="header-card">
    <view class="city-hero">
      <image class="city-image" src="{{cityImage}}" mode="widthFix" binderror="onImageError" wx:if="{{cityImage}}"/>
      <view class="city-gradient" wx:if="{{!cityImage}}">
        <text class="gradient-text">城市</text>
      </view>
      <view class="city-overlay">
        <view class="city-badge" wx:if="{{isVisited}}">
          <text>已点亮</text>
        </view>
        <text class="city-name">{{cityName}}</text>
        <text class="city-province">{{provinceName}}</text>
        <view class="city-stats" wx:if="{{travelPhotos.length > 0 || foodPhotos.length > 0}}">
          <text class="city-stat" wx:if="{{travelPhotos.length > 0}}">{{travelPhotos.length}} 张旅行照</text>
          <text class="city-stat" wx:if="{{foodPhotos.length > 0}}">{{foodPhotos.length}} 张美食照</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 快捷操作：固定两项主操作，避免未点亮时留下空白栏位 -->
  <view class="quick-actions">
    <view class="quick-action-main {{isVisited ? 'visited' : ''}}" bindtap="toggleVisit">
      <view class="quick-action-icon">
        <view class="icon-pin"></view>
      </view>
      <view class="quick-action-copy">
        <text class="quick-action-kicker">旅行足迹</text>
        <text class="quick-action-label">{{isVisited ? '已点亮城市' : '点亮城市'}}</text>
        <text class="quick-action-hint">{{isVisited ? '已加入你的旅行地图' : '解锁城市专属角色'}}</text>
      </view>
    </view>
    <view class="quick-action-card" bindtap="goToCard">
      <view class="quick-action-icon icon-card">
        <view class="icon-card-inner"></view>
      </view>
      <view class="quick-action-copy">
        <text class="quick-action-kicker">省份图鉴</text>
        <text class="quick-action-label">查看角色卡</text>
        <text class="quick-action-hint">了解这张旅行角色</text>
      </view>
    </view>
  </view>
  <view class="quick-action-danger" wx:if="{{isVisited}}" bindtap="removeCity">移除这座城市的个人记录</view>

  <!-- 城市简介 -->
  <view class="intro-card" wx:if="{{cityIntro}}">
    <view class="intro-header">
      <text class="intro-title">城市印象</text>
    </view>
    <text class="intro-text">{{cityIntro}}</text>
  </view>

  <!-- 地标推荐 -->
  <view class="landmark-card" wx:if="{{landmark}}">
    <view class="landmark-header">
      <view>
        <text class="landmark-title">旅行必去</text>
        <text class="landmark-subtitle" wx:if="{{isProvinceEntry}}">为这片土地挑出的三处风景</text>
      </view>
    </view>
    <view class="landmark-tags">
      <text class="landmark-tag" wx:for="{{landmarkList}}" wx:key="index">{{item}}</text>
    </view>
  </view>

  <!-- 城市攻略 -->
  <view class="guide-card" wx:if="{{cityGuide}}">
    <view class="guide-header">
      <text class="guide-title">旅行攻略</text>
    </view>
    <view class="guide-intro">
      <text class="guide-intro-text">{{cityGuide.intro}}</text>
    </view>
    <view class="guide-info-row" wx:if="{{cityGuide.bestSeason}}">
      <text class="guide-info-label">最佳季节</text>
      <text class="guide-info-value">{{cityGuide.bestSeason}}</text>
    </view>
    <view class="guide-info-row" wx:if="{{cityGuide.transport}}">
      <text class="guide-info-label">交通建议</text>
      <text class="guide-info-value">{{cityGuide.transport}}</text>
    </view>
    <view class="guide-info-row" wx:if="{{cityGuide.tips}}">
      <text class="guide-info-label">实用提示</text>
      <text class="guide-info-value">{{cityGuide.tips}}</text>
    </view>
  </view>

  <!-- 照片分类标签 -->
  <view class="group-footprint-card" wx:if="{{hasGroup}}">
    <view class="group-footprint-head">
      <view>
        <text class="group-footprint-kicker">群组城市档案</text>
        <text class="group-footprint-title">{{cityName}} 的共同足迹</text>
      </view>
      <view class="group-footprint-pill">{{groupVisitors.length}}人到过</view>
    </view>

    <view class="group-footprint-empty" wx:if="{{!loadingGroupFootprint && groupVisitors.length === 0 && groupSharedPhotos.length === 0}}">
      <text>群组里还没人留下这座城市的足迹。你点亮后，朋友打开同一座城市就能看见。</text>
    </view>

    <view class="group-visitors" wx:if="{{groupVisitors.length > 0}}">
      <view class="group-visitor" wx:for="{{groupVisitors}}" wx:key="openid">
        <image class="group-visitor-avatar" src="{{item.avatarUrl || '/images/avatar.jpg'}}" mode="aspectFill"/>
        <text class="group-visitor-name">{{item.nickName}}</text>
      </view>
    </view>

    <view class="group-photo-strip" wx:if="{{groupSharedPhotos.length > 0}}">
      <view class="group-photo-item" wx:for="{{groupSharedPhotos}}" wx:key="id" bindtap="previewGroupPhoto" data-index="{{index}}">
        <image class="group-photo-img" src="{{item.displayUrl || item.url || item.fileId}}" mode="aspectFill"/>
        <view class="group-photo-meta">{{item.userName || item.nickName}}</view>
      </view>
    </view>

    <view class="group-share-alert" wx:if="{{groupShareError}}">
      <text class="group-share-alert-text">{{groupShareError}}</text>
      <view class="group-share-retry" wx:if="{{pendingGroupPhotoShare}}" bindtap="retryGroupPhotoShare">{{syncingGroupPhotos ? '同步中...' : '重新同步'}}</view>
    </view>

    <view class="group-footprint-note" wx:if="{{groupSharedPhotos.length === 0 && groupVisitors.length > 0}}">
      <text>这座城市已有群友点亮，公开照片会出现在这里。</text>
    </view>
  </view>

  <view class="photo-tabs">
    <view class="photo-tab {{activeTab === 'travel' ? 'active' : ''}}" bindtap="switchTab" data-tab="travel">
      <text class="tab-text">美景</text>
      <text class="tab-count" wx:if="{{travelPhotos.length > 0}}">{{travelPhotos.length}}</text>
    </view>
    <view class="photo-tab {{activeTab === 'food' ? 'active' : ''}}" bindtap="switchTab" data-tab="food">
      <text class="tab-text">美食</text>
      <text class="tab-count" wx:if="{{foodPhotos.length > 0}}">{{foodPhotos.length}}</text>
    </view>
  </view>

  <view class="photo-date-picker" wx:if="{{!isProvinceEntry}}">
    <text class="photo-date-label">记录日期</text>
    <picker mode="date" value="{{photoTravelDate}}" bindchange="onPhotoTravelDateChange">
      <view class="photo-date-value">{{photoTravelDate}}</view>
    </picker>
  </view>

  <!-- 添加照片按钮（整合到标签下方，更醒目） -->
  <view class="add-photo-btn" bindtap="addPhoto">
    <view class="add-photo-icon-wrap">
      <text class="add-photo-icon">+</text>
    </view>
    <text class="add-photo-text">添加{{activeTab === 'travel' ? '美景' : '美食'}}照片</text>
  </view>

  <!-- 照片网格 -->
  <view class="photos-card" wx:if="{{activeTab === 'travel' && travelPhotos.length > 0}}">
    <view class="photos-header">
      <text class="photos-title">美景回忆</text>
      <text class="photos-count">{{travelPhotos.length}} 张</text>
    </view>
    <view class="photos-grid">
      <view wx:for="{{travelPhotos}}" wx:key="index" class="photo-item" bindtap="previewPhoto" data-index="{{index}}">
        <image class="photo-image" src="{{item.displayUrl || item.url || item}}" mode="aspectFill"/>
        <view class="photo-status private" wx:if="{{item.status === 'private'}}">仅自己可见</view>
        <view class="photo-status group" wx:if="{{item.status === 'group'}}">{{item.userName || '队友'}}共享</view>
        <view class="photo-delete" wx:if="{{item.status !== 'group'}}" catchtap="deletePhoto" data-index="{{index}}">
          <text>×</text>
        </view>
      </view>
    </view>
  </view>

  <view class="photos-card" wx:if="{{activeTab === 'food' && foodPhotos.length > 0}}">
    <view class="photos-header">
      <text class="photos-title">美食记忆</text>
      <text class="photos-count">{{foodPhotos.length}} 张</text>
    </view>
    <view class="photos-grid">
      <view wx:for="{{foodPhotos}}" wx:key="index" class="photo-item" bindtap="previewPhoto" data-index="{{index}}">
        <image class="photo-image" src="{{item.displayUrl || item.url || item}}" mode="aspectFill"/>
        <view class="photo-status private" wx:if="{{item.status === 'private'}}">仅自己可见</view>
        <view class="photo-status group" wx:if="{{item.status === 'group'}}">{{item.userName || '队友'}}共享</view>
        <view class="photo-delete" wx:if="{{item.status !== 'group'}}" catchtap="deletePhoto" data-index="{{index}}">
          <text>×</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-card" wx:if="{{(activeTab === 'travel' && travelPhotos.length === 0) || (activeTab === 'food' && foodPhotos.length === 0)}}">
    <view class="empty-content">
      <text class="empty-text">{{activeTab === 'travel' ? '还没有美景照片' : '还没有美食照片'}}</text>
      <text class="empty-hint">点击上方按钮添加</text>
    </view>
  </view>

  <!-- 旅行笔记 -->
  <view class="note-card">
    <view class="note-header">
      <text class="note-title">旅行笔记</text>
      <view class="note-delete-btn" wx:if="{{note}}" bindtap="deleteNote">
        <text>删除</text>
      </view>
    </view>
    <textarea class="note-textarea" placeholder="记录你的旅行感受..." value="{{note}}" bindinput="onNoteInput" maxlength="200"/>
    <view class="note-footer">
      <text class="note-count">{{note.length}}/200</text>
      <view class="note-save" bindtap="saveNote">
        <text>保存</text>
      </view>
    </view>
  </view>

  <!-- 避坑指南 -->
  <view class="note-card avoid-card">
    <view class="note-header">
      <text class="note-title">避坑指南</text>
      <view class="note-delete-btn" wx:if="{{avoidTip}}" bindtap="deleteAvoidTip">
        <text>删除</text>
      </view>
    </view>
    <textarea class="note-textarea avoid-textarea" placeholder="分享交通、住宿等方面的经验教训，帮助其他旅行者少走弯路..." value="{{avoidTip}}" bindinput="onAvoidTipInput" maxlength="300"/>
    <view class="note-footer">
      <text class="note-count">{{avoidTip.length}}/300</text>
      <view class="note-save" bindtap="saveAvoidTip">
        <text>保存</text>
      </view>
    </view>
  </view>
  <view class="achievement-popup {{showAchievementPopup ? 'show' : ''}}">
    <view class="achievement-popup-bg" bindtap="closeAchievementPopup"></view>
    <view class="achievement-popup-content">
      <view class="achievement-popup-badge-wrap">
        <image class="achievement-popup-badge" src="{{newAchievement.badge}}" mode="aspectFit"/>
      </view>
      <text class="achievement-popup-kicker">新成就解锁</text>
      <text class="achievement-popup-name">{{newAchievement.title}}</text>
      <text class="achievement-popup-desc">{{newAchievement.desc}}</text>
      <view class="achievement-popup-reward">+{{newAchievement.reward}} 积分</view>
      <view class="achievement-popup-btn" bindtap="closeAchievementPopup">收进成就墙</view>
    </view>
  </view>
  <privacy-popup id="privacyPopup" bindagree="onPrivacyAgree" bindreject="onPrivacyReject"></privacy-popup>
</view>
