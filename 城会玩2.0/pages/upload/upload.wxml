<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">记录足迹</text>
    <text class="page-subtitle">选择城市，上传照片，分享你的旅行故事</text>
  </view>

  <!-- 城市选择 -->
  <view class="city-select-section">
    <text class="section-label">选择城市</text>
    <view class="city-select-btn {{selectedCity ? 'has-value' : ''}}" bindtap="showCityPicker">
      <text wx:if="{{!selectedCity}}">点击选择城市</text>
      <text wx:else>{{selectedCity.name}}</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 照片上传 -->
  <view class="photo-upload-section">
    <text class="section-label">上传照片</text>
    <view class="photo-upload-grid">
      <!-- 已选照片 -->
      <view 
        wx:for="{{selectedPhotos}}" 
        wx:key="index"
        class="upload-item"
      >
        <image class="upload-img" src="{{item}}" mode="aspectFill"/>
        <view class="delete-btn" catchtap="removePhoto" data-index="{{index}}">
          <text>×</text>
        </view>
      </view>
      
      <!-- 添加按钮 -->
      <view class="upload-add-btn" bindtap="choosePhotos" wx:if="{{selectedPhotos.length < 9}}">
        <text class="add-icon">+</text>
        <text class="add-text">添加照片</text>
      </view>
    </view>
  </view>

  <!-- 旅行笔记 -->
  <view class="note-section">
    <text class="section-label">旅行笔记（可选）</text>
    <textarea 
      class="note-input"
      placeholder="记录这座城市给你的印象..."
      placeholder-class="placeholder"
      maxlength="200"
      bindinput="onNoteInput"
      value="{{note}}"
    />
    <text class="note-count">{{note.length}}/200</text>
  </view>

  <!-- 日期选择 -->
  <view class="date-section">
    <text class="section-label">旅行日期</text>
    <picker mode="date" value="{{visitDate}}" bindchange="onDateChange">
      <view class="date-picker">
        <text>{{visitDate}}</text>
        <text class="arrow">›</text>
      </view>
    </picker>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <view class="submit-btn btn-gold {{!canSubmit ? 'disabled' : ''}}" bindtap="submit">
      <text>保存足迹</text>
    </view>
    <view class="submit-btn btn-secondary" bindtap="cancel">
      <text>取消</text>
    </view>
  </view>

  <!-- 底部装饰 -->
  <view class="bottom-decoration">
    <text class="decoration-line"></text>
  </view>
  <privacy-popup id="privacyPopup" bindagree="onPrivacyAgree" bindreject="onPrivacyReject"></privacy-popup>
</view>
