.container {
  padding-bottom: 120rpx;
}

/* 页面头部 */
.page-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--text-muted);
}

/* 区块标签 */
.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 16rpx;
}

/* 城市选择 */
.city-select-section {
  margin-bottom: 32rpx;
}

.city-select-btn {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-md);
  color: var(--text-muted);
  font-size: 28rpx;
}

.city-select-btn.has-value {
  color: var(--pink-dark);
  font-weight: 500;
}

.arrow {
  font-size: 32rpx;
  color: var(--text-muted);
}

/* 照片上传 */
.photo-upload-section {
  margin-bottom: 32rpx;
}

.photo-upload-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.upload-item {
  position: relative;
  aspect-ratio: 1;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 1rpx solid var(--border-color);
}

.upload-img {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-primary);
  font-size: 28rpx;
}

.upload-add-btn {
  aspect-ratio: 1;
  border-radius: var(--radius-md);
  border: 2rpx dashed var(--border-color);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: var(--bg-glass);
}

.upload-add-btn:active {
  background: rgba(255, 255, 255, 0.1);
}

.add-icon {
  font-size: 48rpx;
  color: var(--pink-primary);
}

.add-text {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 旅行笔记 */
.note-section {
  margin-bottom: 32rpx;
}

.note-input {
  width: 100%;
  height: 200rpx;
  padding: 24rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-md);
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.placeholder {
  color: var(--text-disabled);
}

.note-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

/* 日期选择 */
.date-section {
  margin-bottom: 48rpx;
}

.date-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-md);
  color: var(--text-primary);
  font-size: 28rpx;
}

/* 提交按钮 */
.submit-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.submit-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* 底部装饰 */
.bottom-decoration {
  display: flex;
  justify-content: center;
  margin-top: 48rpx;
  opacity: 0.2;
}

.decoration-icon {
  width: 160rpx;
  height: 64rpx;
  opacity: 0.5;
}
