.page-container {
  min-height: 100vh;
  background: var(--bg-primary, #F8F5F2);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 0;
  box-sizing: border-box;
}

/* 角色卡大图 - 拉长 */
.card-image-section {
  width: 92vw;
  height: 600rpx;
  flex-shrink: 0;
  margin-top: 0;
}

.card-image-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: var(--radius-md, 16rpx);
  overflow: hidden;
  box-shadow: var(--shadow-lg, 0 8rpx 32rpx rgba(0,0,0,0.12));
}

.card-image {
  width: 100%;
  height: 100%;
}

.card-rarity {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #FFFFFF;
  z-index: 2;
}

.card-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.55);
  backdrop-filter: blur(4rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 3;
}

.lock-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.lock-icon {
  width: 32rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255,255,255,0.8);
  border-radius: 4rpx;
  position: relative;
}

.lock-icon::before {
  content: '';
  position: absolute;
  top: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 20rpx;
  border: 4rpx solid rgba(255,255,255,0.8);
  border-bottom: none;
  border-radius: 20rpx 20rpx 0 0;
}

.lock-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

/* 角色信息 */
.info-section {
  text-align: center;
  margin-top: 16rpx;
  flex-shrink: 0;
}

.character-name {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-primary, #4A4A4A);
  display: block;
  line-height: 1.2;
}

.character-title {
  font-size: 24rpx;
  color: var(--pink-primary, #F4A6B5);
  margin-top: 6rpx;
  display: block;
  line-height: 1.3;
}

.province-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  background: rgba(244, 166, 181, 0.12);
  border-radius: 30rpx;
}

.province-name {
  font-size: 24rpx;
  color: var(--text-primary, #4A4A4A);
}

.province-abbr {
  font-size: 20rpx;
  color: var(--pink-primary, #F4A6B5);
  background: rgba(244, 166, 181, 0.15);
  padding: 2rpx 8rpx;
  border-radius: 20rpx;
}

/* 区块标题 */
.section-header {
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary, #4A4A4A);
  position: relative;
  padding-left: 16rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 20rpx;
  background: var(--pink-primary, #F4A6B5);
  border-radius: 2rpx;
}

/* 属性区域 */
.attributes-section {
  width: 92vw;
  margin-top: 16rpx;
  background: #FFFFFF;
  border-radius: var(--radius-md, 16rpx);
  padding: 20rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 12rpx rgba(0,0,0,0.06));
  flex-shrink: 0;
}

.attr-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.attr-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.attr-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  position: relative;
  flex-shrink: 0;
}

.icon-culture { background: linear-gradient(135deg, var(--pink-primary, #F4A6B5), #F9D5BB); }
.icon-culture::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 14rpx;
  border: 2rpx solid #FFFFFF;
  border-radius: 2rpx;
}

.icon-fashion { background: linear-gradient(135deg, #AA96DA, #F4A6B5); }
.icon-fashion::before {
  content: '';
  position: absolute;
  top: 45%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid #FFFFFF;
  border-radius: 50%;
}

.icon-food { background: linear-gradient(135deg, #F9D5BB, #FFD700); }
.icon-food::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FFFFFF;
}

.icon-history { background: linear-gradient(135deg, #AA96DA, #7B8CDE); }
.icon-history::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 12rpx;
  background: #FFFFFF;
  border-radius: 2rpx;
}

.icon-history::after {
  content: '';
  position: absolute;
  top: 22%;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 6rpx;
  background: #FFFFFF;
  border-radius: 2rpx 2rpx 0 0;
}

.attr-label {
  width: 60rpx;
  font-size: 24rpx;
  color: #888888;
  flex-shrink: 0;
}

.attr-bar-bg {
  flex: 1;
  height: 16rpx;
  background: #F0F0F0;
  border-radius: 8rpx;
  overflow: hidden;
}

.attr-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 1.2s ease;
}

.attr-bar-fill.culture { background: linear-gradient(90deg, var(--pink-primary, #F4A6B5), #F9D5BB); }
.attr-bar-fill.fashion { background: linear-gradient(90deg, #AA96DA, #F4A6B5); }
.attr-bar-fill.food { background: linear-gradient(90deg, #F9D5BB, #FFD700); }
.attr-bar-fill.history { background: linear-gradient(90deg, #AA96DA, #7B8CDE); }

.attr-score {
  width: 48rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--pink-primary, #F4A6B5);
  flex-shrink: 0;
}

/* 技能 + 引言合并卡片 */
.skill-quote-section {
  width: 92vw;
  margin-top: 16rpx;
  background: #FFFFFF;
  border-radius: var(--radius-md, 16rpx);
  padding: 20rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 12rpx rgba(0,0,0,0.06));
  flex-shrink: 0;
}

.skill-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.skill-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  position: relative;
  flex-shrink: 0;
  background: linear-gradient(135deg, #F9D5BB, #FFD700);
}

.icon-skill::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 4rpx;
  height: 16rpx;
  background: #FFFFFF;
  border-radius: 2rpx;
  box-shadow: 0 -6rpx 0 #FFFFFF;
}

.skill-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary, #4A4A4A);
}

.quote-divider {
  height: 1rpx;
  background: #F0F0F0;
  margin: 12rpx 0;
}

.quote-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.quote-mark {
  font-size: 24rpx;
  color: #CCCCCC;
  line-height: 1.4;
}

.quote-text {
  flex: 1;
  font-size: 24rpx;
  color: #999999;
  font-style: italic;
  line-height: 1.6;
}

/* 角色故事 */
.story-section {
  width: 92vw;
  margin-top: 16rpx;
  background: #FFFFFF;
  border-radius: var(--radius-md, 16rpx);
  padding: 20rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 12rpx rgba(0,0,0,0.06));
  flex-shrink: 0;
}

.story-text {
  font-size: 26rpx;
  color: var(--text-secondary, #5A5A5A);
  line-height: 1.8;
}

/* 未解锁 */
.locked-section {
  width: 92vw;
  margin-top: 16rpx;
  flex-shrink: 0;
}

.locked-card {
  text-align: center;
  padding: 40rpx 24rpx;
  background: #FFFFFF;
  border-radius: var(--radius-md, 16rpx);
  box-shadow: var(--shadow-sm, 0 2rpx 12rpx rgba(0,0,0,0.06));
}

.locked-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #AAAAAA;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.lock-icon-small {
  width: 24rpx;
  height: 30rpx;
  border: 3rpx solid #AAAAAA;
  border-radius: 3rpx;
  position: relative;
}

.lock-icon-small::before {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid #AAAAAA;
  border-bottom: none;
  border-radius: 14rpx 14rpx 0 0;
}

.locked-hint {
  font-size: 24rpx;
  color: #BBBBBB;
  margin-top: 12rpx;
  display: block;
}

.locked-rarity {
  font-size: 24rpx;
  color: var(--pink-primary, #F4A6B5);
  margin-top: 8rpx;
  display: block;
}

/* 底部按钮 */
.bottom-actions {
  width: 92vw;
  margin-top: 24rpx;
  margin-bottom: 24rpx;
  padding-top: 8rpx;
  padding-bottom: env(safe-area-inset-bottom, 0rpx);
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  line-height: 1;
}

.action-btn::after {
  border: none;
}

.btn-back {
  background: #FFFFFF;
  color: var(--text-primary, #4A4A4A);
  box-shadow: var(--shadow-sm, 0 2rpx 12rpx rgba(0,0,0,0.06));
}

.btn-share {
  background: var(--pink-primary, #F4A6B5);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(244, 166, 181, 0.35);
}

.btn-icon {
  width: 28rpx;
  height: 28rpx;
  position: relative;
}

.icon-back::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-25%, -50%) rotate(-45deg);
  width: 10rpx;
  height: 10rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
}

.icon-share::before {
  content: '';
  position: absolute;
  top: 55%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 10rpx;
  height: 10rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}

.icon-share::after {
  content: '';
  position: absolute;
  top: 20%;
  left: 50%;
  transform: translateX(-50%);
  width: 2rpx;
  height: 10rpx;
  background: currentColor;
}