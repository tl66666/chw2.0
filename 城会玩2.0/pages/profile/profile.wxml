<view class="container">
  <view class="header-bg">
    <view class="header-wave"></view>
  </view>

  <view class="user-card">
    <view class="user-avatar-section">
      <view class="avatar-wrapper" bindtap="changeAvatar">
        <image class="user-avatar" src="{{userInfo.avatarUrl || '/images/avatar.jpg'}}" mode="aspectFill" binderror="onAvatarError"/>
        <view class="avatar-edit-mask">
          <image class="avatar-edit-icon" src="/images/launch/icon-camera.jpg" mode="aspectFit"/>
          <text class="avatar-edit-text">更换头像</text>
        </view>
        <view class="avatar-glow"></view>
      </view>
      <view class="user-info">
        <text class="user-name">{{userInfo.nickName || '旅行者'}}</text>
        <view class="user-level-tag">
          <view class="level-icon-wrap">
            <text class="level-icon-text">Lv</text>
          </view>
          <text class="level-text">{{levelInfo.title}}</text>
        </view>
        <view class="profile-edit-pill" bindtap="openEditProfile">编辑资料</view>
      </view>
    </view>

    <view class="exp-section">
      <view class="exp-header">
        <text class="exp-label">探索经验</text>
        <text class="exp-value">{{levelInfo.currentExp}} / {{levelInfo.nextExp}}</text>
      </view>
      <view class="exp-progress-bg">
        <view class="exp-progress-fill" style="width: {{levelInfo.progress}}%;"></view>
      </view>
      <text class="exp-hint" wx:if="{{levelInfo.needCities > 0}}">再点亮 {{levelInfo.needCities}} 座城市可升级</text>
      <text class="exp-hint" wx:else>已达到最高等级</text>
    </view>
  </view>

  <view class="login-panel" wx:if="{{!isWechatUser}}">
    <view class="login-stamp">云同步</view>
    <view class="login-copy">
      <text class="login-title">登录后备份你的城市图鉴</text>
      <text class="login-desc">仅用于生成账号标识，方便云端备份、加入群组和共享照片，不会强制获取头像昵称。</text>
    </view>
    <view class="login-actions">
      <view class="login-btn primary" bindtap="loginWithWechat">微信登录</view>
      <view class="login-btn ghost" bindtap="goLaunch">返回介绍页</view>
    </view>
  </view>

  <view class="stats-section">
    <view class="section-title-row">
      <view>
        <text class="stats-title">城市图鉴</text>
        <text class="section-subtitle">你的旅行进度一眼看清</text>
      </view>
    </view>
    <view class="stats-grid">
      <view class="stat-card stat-card-cities">
        <view class="stat-icon-wrap">
          <text class="stat-icon-text">城</text>
        </view>
        <text class="stat-value">{{visitedCount}}</text>
        <text class="stat-label">点亮城市</text>
      </view>
      <view class="stat-card stat-card-provinces">
        <view class="stat-icon-wrap">
          <text class="stat-icon-text">省</text>
        </view>
        <text class="stat-value">{{visitedProvinces}}</text>
        <text class="stat-label">探索省份</text>
      </view>
      <view class="stat-card stat-card-photos">
        <view class="stat-icon-wrap">
          <text class="stat-icon-text">照</text>
        </view>
        <text class="stat-value">{{photoCount}}</text>
        <text class="stat-label">照片总数</text>
      </view>
      <view class="stat-card stat-card-progress">
        <view class="stat-icon-wrap">
          <text class="stat-icon-text">%</text>
        </view>
        <text class="stat-value">{{completionRate}}%</text>
        <text class="stat-label">完成度</text>
      </view>
    </view>
  </view>

  <view class="photo-stats" wx:if="{{photoCount > 0}}">
    <view class="photo-stat-item">
      <view class="photo-stat-icon-wrap photo-stat-travel">
        <text class="photo-stat-icon-text">行</text>
      </view>
      <text class="photo-stat-value">{{travelPhotoCount}}</text>
      <text class="photo-stat-label">旅行照片</text>
    </view>
    <view class="photo-stat-divider"></view>
    <view class="photo-stat-item">
      <view class="photo-stat-icon-wrap photo-stat-food">
        <text class="photo-stat-icon-text">味</text>
      </view>
      <text class="photo-stat-value">{{foodPhotoCount}}</text>
      <text class="photo-stat-label">美食照片</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="section-title-row">
      <view>
        <text class="menu-title">旅行工具</text>
        <text class="section-subtitle">记录、整理、分享你的足迹</text>
      </view>
    </view>
    <view class="menu-grid">
      <view class="menu-grid-item" bindtap="goToUpload">
        <view class="menu-grid-icon menu-icon-upload">
          <text class="menu-grid-icon-text">记</text>
        </view>
        <view class="menu-grid-copy">
          <text class="menu-grid-name">记录足迹</text>
          <text class="menu-grid-desc">添加城市、照片和笔记</text>
        </view>
      </view>

      <view class="menu-grid-item" bindtap="goToAlbum">
        <view class="menu-grid-icon menu-icon-album">
          <text class="menu-grid-icon-text">册</text>
        </view>
        <view class="menu-grid-copy">
          <text class="menu-grid-name">我的相册</text>
          <text class="menu-grid-desc">查看旅行照片墙</text>
        </view>
      </view>

      <view class="menu-grid-item" bindtap="goToGroup">
        <view class="menu-grid-icon menu-icon-group">
          <text class="menu-grid-icon-text">友</text>
        </view>
        <view class="menu-grid-copy">
          <text class="menu-grid-name">我的群组</text>
          <text class="menu-grid-desc">和好友一起打卡</text>
        </view>
      </view>

      <view class="menu-grid-item" bindtap="goToAchievements">
        <view class="menu-grid-icon menu-icon-achievement">
          <text class="menu-grid-icon-text">章</text>
        </view>
        <view class="menu-grid-copy">
          <text class="menu-grid-name">成就系统</text>
          <text class="menu-grid-desc">解锁旅行徽章</text>
        </view>
      </view>

      <view class="menu-grid-item" bindtap="shareApp">
        <view class="menu-grid-icon menu-icon-share">
          <text class="menu-grid-icon-text">享</text>
        </view>
        <view class="menu-grid-copy">
          <text class="menu-grid-name">分享好友</text>
          <text class="menu-grid-desc">邀请朋友一起记录</text>
        </view>
      </view>

      <view class="menu-grid-item" bindtap="goToSettings">
        <view class="menu-grid-icon menu-icon-settings">
          <text class="menu-grid-icon-text">设</text>
        </view>
        <view class="menu-grid-copy">
          <text class="menu-grid-name">设置</text>
          <text class="menu-grid-desc">管理偏好与数据</text>
        </view>
      </view>

      <view class="menu-grid-item" bindtap="openEditProfile">
        <view class="menu-grid-icon menu-icon-profile">
          <text class="menu-grid-icon-text">名</text>
        </view>
        <view class="menu-grid-copy">
          <text class="menu-grid-name">编辑名片</text>
          <text class="menu-grid-desc">换头像、改昵称</text>
        </view>
      </view>
    </view>
  </view>

  <view class="activity-section" wx:if="{{recentActivities.length > 0}}">
    <view class="activity-header">
      <text class="activity-title">最近动态</text>
      <text class="activity-more" bindtap="goToAlbum">查看全部</text>
    </view>
    <view class="activity-list">
      <view class="activity-item" wx:for="{{recentActivities}}" wx:key="index">
        <view class="activity-icon-wrap activity-icon-{{item.type}}">
          <text class="activity-icon-text">{{item.iconText}}</text>
        </view>
        <view class="activity-content">
          <text class="activity-text">{{item.text}}</text>
          <text class="activity-time">{{item.time}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="danger-zone">
    <view class="danger-item" bindtap="clearData">
      <view class="danger-icon-wrap">
        <text class="danger-icon-text">清</text>
      </view>
      <text class="danger-text">清除所有本地旅行数据</text>
      <text class="danger-arrow">›</text>
    </view>
  </view>

  <view class="bottom-decoration">
    <view class="bottom-line"></view>
    <text class="bottom-text">用脚步丈量世界</text>
    <view class="bottom-line"></view>
  </view>

  <view class="edit-profile-modal" wx:if="{{showEditProfile}}">
    <view class="edit-profile-mask" bindtap="closeEditProfile"></view>
    <view class="edit-profile-card">
      <view class="edit-profile-top">
        <view>
          <text class="edit-profile-kicker">TRAVEL ID</text>
          <text class="edit-profile-title">编辑旅行名片</text>
        </view>
        <view class="edit-profile-close" bindtap="closeEditProfile">×</view>
      </view>
      <view class="edit-avatar-box" bindtap="chooseEditAvatar">
        <image class="edit-avatar-img" src="{{editAvatarUrl || '/images/avatar.jpg'}}" mode="aspectFill"/>
        <view class="edit-avatar-badge">换头像</view>
      </view>
      <view class="edit-field">
        <text class="edit-label">昵称</text>
        <input class="edit-input" value="{{editNickName}}" maxlength="12" placeholder="写一个好记的旅行昵称" bindinput="onNickNameInput"/>
      </view>
      <view class="edit-profile-actions">
        <view class="edit-action ghost" bindtap="closeEditProfile">取消</view>
        <view class="edit-action primary" bindtap="saveProfile">保存</view>
      </view>
    </view>
  </view>
  <privacy-popup id="privacyPopup" bindagree="onPrivacyAgree" bindreject="onPrivacyReject"></privacy-popup>
</view>
