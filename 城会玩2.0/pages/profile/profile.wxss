.container {
  --profile-paper: #F5F3EE;
  --profile-surface: #FFFEFB;
  --profile-ink: #3F3732;
  --profile-secondary: #70675F;
  --profile-muted: #9A9189;
  --profile-line: rgba(63, 55, 50, 0.12);
  --profile-red: #B65E4A;
  --profile-red-soft: #F4E3DC;
  --profile-blue: #AFC6D8;
  --profile-blue-soft: #E8F0F4;
  --profile-sage: #C7D4C6;
  --profile-sage-soft: #EDF2EA;
  --profile-display: 'Songti SC', 'STSong', 'Noto Serif CJK SC', serif;
  --profile-body: 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  min-height: 100vh;
  padding: 0 24rpx 52rpx;
  box-sizing: border-box;
  background: var(--profile-paper);
  color: var(--profile-ink);
  font-family: var(--profile-body);
}

.profile-masthead {
  position: relative;
  min-height: 216rpx;
  margin: 0 -24rpx;
  padding: 46rpx 32rpx 30rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  box-sizing: border-box;
  overflow: hidden;
  background: #E9E4DA;
  border-bottom: 1rpx solid rgba(63, 55, 50, 0.14);
}

.profile-hero-art {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.masthead-copy,
.masthead-mark {
  position: relative;
  z-index: 1;
}

.masthead-copy {
  max-width: 430rpx;
}

.masthead-kicker,
.edit-profile-kicker {
  display: block;
  color: #8B7368;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.masthead-title {
  display: block;
  margin-top: 5rpx;
  color: var(--profile-ink);
  font-family: var(--profile-display);
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.1;
}

.masthead-desc {
  display: block;
  margin-top: 10rpx;
  color: #6F6158;
  font-size: 22rpx;
  line-height: 1.5;
}

.masthead-mark {
  margin-bottom: 4rpx;
  padding: 9rpx 14rpx;
  border: 1rpx solid rgba(63, 55, 50, 0.34);
  background: rgba(255, 254, 251, 0.62);
  color: #66564D;
  font-family: var(--profile-display);
  font-size: 22rpx;
  transform: rotate(-3deg);
}

.user-card,
.login-panel,
.activity-list,
.danger-item {
  background: var(--profile-surface);
  border: 1rpx solid var(--profile-line);
  box-shadow: none;
}

.user-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 14rpx;
}

.user-avatar-section {
  display: flex;
  align-items: center;
}

.avatar-wrapper {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.user-avatar,
.avatar-edit-mask {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
}

.user-avatar {
  display: block;
  box-sizing: border-box;
  border: 4rpx solid #FFFFFF;
  background: #E8E4DD;
  box-shadow: 0 4rpx 12rpx rgba(63, 55, 50, 0.12);
}

.avatar-edit-mask {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  opacity: 0;
  background: rgba(49, 43, 39, 0.56);
  transition: opacity 0.18s ease;
}

.avatar-wrapper:active .avatar-edit-mask {
  opacity: 1;
}

.avatar-edit-icon {
  width: 30rpx;
  height: 30rpx;
  margin-bottom: 4rpx;
}

.avatar-edit-text {
  color: #FFFFFF;
  font-size: 18rpx;
}

.avatar-glow,
.header-bg,
.header-wave {
  display: none;
}

.user-info {
  min-width: 0;
  flex: 1;
  text-align: left;
}

.user-name {
  display: block;
  overflow: hidden;
  color: var(--profile-ink);
  font-family: var(--profile-display);
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-level-tag {
  display: inline-flex;
  align-items: center;
  margin-top: 10rpx;
  padding: 5rpx 12rpx 5rpx 7rpx;
  color: #775246;
  background: var(--profile-red-soft);
  border-radius: 4rpx;
}

.level-icon-wrap {
  width: 30rpx;
  height: 30rpx;
  margin-right: 7rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--profile-red);
  border-radius: 2rpx;
}

.level-icon-text,
.level-text {
  font-size: 20rpx;
  font-weight: 700;
}

.level-icon-text {
  color: #FFFFFF;
  line-height: 1;
}

.profile-edit-pill {
  display: inline-flex;
  margin-top: 10rpx;
  color: #756B63;
  font-size: 22rpx;
  text-decoration: underline;
  text-decoration-color: #CBBAB0;
  text-underline-offset: 6rpx;
}

.exp-section {
  margin-top: 26rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--profile-line);
}

.exp-header,
.activity-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.exp-header {
  margin-bottom: 10rpx;
}

.exp-label,
.exp-value {
  font-size: 23rpx;
}

.exp-label {
  color: var(--profile-secondary);
}

.exp-value {
  color: var(--profile-red);
  font-weight: 700;
}

.exp-progress-bg {
  height: 10rpx;
  overflow: hidden;
  background: #EEE9E1;
  border-radius: 2rpx;
}

.exp-progress-fill {
  height: 100%;
  background: var(--profile-red);
  border-radius: inherit;
  transition: width 0.35s ease;
}

.exp-hint {
  display: block;
  margin-top: 9rpx;
  color: var(--profile-muted);
  font-size: 21rpx;
}

.login-panel {
  position: relative;
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 12rpx;
}

.login-panel::before {
  content: '';
  position: absolute;
  top: 18rpx;
  bottom: 18rpx;
  left: 0;
  width: 5rpx;
  background: var(--profile-blue);
}

.login-stamp {
  position: absolute;
  top: 18rpx;
  right: 20rpx;
  padding: 4rpx 10rpx;
  color: #557383;
  background: var(--profile-blue-soft);
  font-size: 20rpx;
  transform: rotate(2deg);
}

.login-copy {
  padding-right: 106rpx;
}

.login-title,
.stats-title,
.menu-title,
.activity-title {
  color: var(--profile-ink);
  font-family: var(--profile-display);
  font-weight: 600;
}

.login-title {
  display: block;
  font-size: 29rpx;
}

.login-desc {
  display: block;
  margin-top: 8rpx;
  color: var(--profile-secondary);
  font-size: 22rpx;
  line-height: 1.65;
}

.login-actions,
.edit-profile-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.login-btn,
.edit-action {
  height: 70rpx;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.login-btn.primary {
  color: #FFFFFF;
  background: #07C160;
}

.login-btn.ghost,
.edit-action.ghost {
  color: var(--profile-secondary);
  background: #F0ECE5;
}

.stats-section,
.menu-section,
.activity-section,
.danger-zone {
  margin-top: 30rpx;
}

.section-title-row {
  margin: 0 4rpx 14rpx;
}

.section-subtitle {
  display: block;
  margin-top: 3rpx;
  color: var(--profile-muted);
  font-size: 21rpx;
}

.stats-title,
.menu-title,
.activity-title {
  font-size: 32rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border: 1rpx solid var(--profile-line);
  background: var(--profile-surface);
}

.stat-card {
  min-width: 0;
  padding: 20rpx 5rpx 17rpx;
  text-align: center;
  border-right: 1rpx solid var(--profile-line);
}

.stat-card:last-child {
  border-right: 0;
}

.stat-icon-wrap {
  width: 38rpx;
  height: 38rpx;
  margin: 0 auto 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--profile-red-soft);
  border-radius: 50%;
}

.stat-card-provinces .stat-icon-wrap { background: var(--profile-blue-soft); }
.stat-card-photos .stat-icon-wrap { background: var(--profile-sage-soft); }
.stat-card-progress .stat-icon-wrap { background: #F2EADF; }

.stat-icon-text {
  color: #67574E;
  font-size: 19rpx;
  font-weight: 700;
}

.stat-value {
  display: block;
  color: var(--profile-ink);
  font-family: var(--profile-display);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.15;
}

.stat-label {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--profile-muted);
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.menu-grid-item {
  min-width: 0;
  min-height: 118rpx;
  padding: 18rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  background: var(--profile-surface);
  border: 1rpx solid var(--profile-line);
  border-radius: 10rpx;
}

.menu-grid-item:active {
  background: #F0ECE5;
}

.menu-grid-icon {
  width: 50rpx;
  height: 50rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--profile-blue-soft);
  border-radius: 6rpx;
}

.menu-icon-achievement { background: #F2EADF; }
.menu-icon-settings { background: var(--profile-sage-soft); }
.menu-icon-profile { background: var(--profile-red-soft); }

.menu-grid-icon::after { display: none; }

.menu-grid-icon-text {
  color: #5C514A;
  font-family: var(--profile-display);
  font-size: 24rpx;
  font-weight: 600;
}

.menu-grid-copy {
  min-width: 0;
}

.menu-grid-name {
  display: block;
  overflow: hidden;
  color: var(--profile-ink);
  font-size: 25rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-grid-desc {
  display: block;
  margin-top: 3rpx;
  overflow: hidden;
  color: var(--profile-muted);
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-section {
  padding: 0;
}

.activity-header {
  margin: 0 4rpx 14rpx;
}

.activity-more {
  color: var(--profile-red);
  font-size: 22rpx;
}

.activity-list {
  padding: 4rpx 22rpx;
  border-radius: 10rpx;
}

.activity-item {
  display: flex;
  align-items: center;
  min-height: 82rpx;
  border-bottom: 1rpx solid var(--profile-line);
}

.activity-item:last-child { border-bottom: 0; }

.activity-icon-wrap {
  width: 42rpx;
  height: 42rpx;
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--profile-red-soft);
  border-radius: 50%;
}

.activity-icon-photo { background: var(--profile-blue-soft); }
.activity-icon-food { background: var(--profile-sage-soft); }
.activity-icon-note { background: #F2EADF; }

.activity-icon-text {
  color: #65564E;
  font-size: 19rpx;
  font-weight: 700;
}

.activity-content { min-width: 0; }

.activity-text {
  display: block;
  overflow: hidden;
  color: var(--profile-secondary);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-time {
  display: block;
  margin-top: 3rpx;
  color: var(--profile-muted);
  font-size: 19rpx;
}

.danger-item {
  min-height: 82rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  border-radius: 10rpx;
}

.danger-icon-wrap {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F7E7E5;
  border-radius: 50%;
}

.danger-icon-text { color: #A8564B; font-size: 18rpx; }
.danger-text { flex: 1; color: #86635C; font-size: 24rpx; }
.danger-arrow { color: #B7AEA6; font-size: 30rpx; }

.bottom-decoration {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 42rpx 0 30rpx;
}

.bottom-line { width: 44rpx; height: 1rpx; background: #D5CDC5; }
.bottom-text { margin: 0 12rpx; color: #A79D94; font-family: var(--profile-display); font-size: 21rpx; }

.edit-profile-modal {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.edit-profile-mask {
  position: absolute;
  inset: 0;
  background: rgba(46, 40, 36, 0.38);
}

.edit-profile-card {
  position: relative;
  width: 100%;
  padding: 28rpx 28rpx calc(34rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--profile-surface);
  border-radius: 16rpx 16rpx 0 0;
}

.edit-profile-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.edit-profile-title {
  display: block;
  margin-top: 4rpx;
  color: var(--profile-ink);
  font-family: var(--profile-display);
  font-size: 36rpx;
  font-weight: 600;
}

.edit-profile-close {
  width: 46rpx;
  height: 46rpx;
  color: var(--profile-secondary);
  background: #F0ECE5;
  border-radius: 50%;
  font-size: 32rpx;
  line-height: 44rpx;
  text-align: center;
}

.edit-avatar-box {
  position: relative;
  width: 130rpx;
  height: 130rpx;
  margin: 0 auto 26rpx;
}

.edit-avatar-img {
  width: 130rpx;
  height: 130rpx;
  box-sizing: border-box;
  border: 4rpx solid #FFFFFF;
  border-radius: 50%;
  background: #E8E4DD;
}

.edit-avatar-badge {
  position: absolute;
  right: -24rpx;
  bottom: -3rpx;
  padding: 6rpx 11rpx;
  color: #775246;
  background: var(--profile-red-soft);
  border-radius: 4rpx;
  font-size: 19rpx;
}

.edit-field {
  padding: 18rpx;
  background: #F7F4EE;
  border: 1rpx solid var(--profile-line);
  border-radius: 8rpx;
}

.edit-label { display: block; margin-bottom: 8rpx; color: var(--profile-secondary); font-size: 22rpx; }

.edit-input {
  height: 66rpx;
  padding: 0 14rpx;
  color: var(--profile-ink);
  background: #FFFFFF;
  border: 1rpx solid var(--profile-line);
  border-radius: 5rpx;
  font-size: 27rpx;
}

.edit-action.primary {
  color: #FFFFFF;
  background: var(--profile-red);
}
