.launch-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  background: #fff7ef;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.paper-grain {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.38), rgba(255, 248, 239, 0.72)),
    radial-gradient(circle at 20% 16%, rgba(255, 184, 149, 0.18), transparent 34%),
    radial-gradient(circle at 82% 48%, rgba(135, 190, 180, 0.16), transparent 28%);
  pointer-events: none;
}

.bg-decoration {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 2;
}

.circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.2;
}

.circle-1 {
  width: 520rpx;
  height: 520rpx;
  background: #f7b6a1;
  top: -180rpx;
  right: -170rpx;
  animation: float 8s ease-in-out infinite;
}

.circle-2 {
  width: 360rpx;
  height: 360rpx;
  background: #9fd6ca;
  bottom: 280rpx;
  left: -130rpx;
  animation: float 10s ease-in-out infinite reverse;
}

.circle-3 {
  width: 240rpx;
  height: 240rpx;
  background: #ffd67d;
  bottom: -70rpx;
  right: 120rpx;
  animation: float 12s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-28rpx) scale(1.04); }
}

.content {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 116rpx;
  flex: 1;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 52rpx;
}

.logo-wrapper {
  position: relative;
  width: 192rpx;
  height: 192rpx;
  margin-bottom: 28rpx;
}

.logo-image {
  width: 100%;
  height: 100%;
  border-radius: 42rpx;
  box-shadow: 0 20rpx 56rpx rgba(143, 78, 50, 0.18);
  animation: logoPulse 3.2s ease-in-out infinite;
}

.logo-glow {
  position: absolute;
  inset: -22rpx;
  background: radial-gradient(circle, rgba(255, 195, 151, 0.34), transparent 70%);
  border-radius: 50%;
  animation: glowPulse 3.2s ease-in-out infinite;
}

@keyframes logoPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.045); }
}

@keyframes glowPulse {
  0%, 100% { opacity: 0.55; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.08); }
}

.app-name {
  font-size: 58rpx;
  font-weight: 800;
  color: #574039;
  margin-bottom: 12rpx;
  letter-spacing: 4rpx;
}

.app-slogan {
  font-size: 27rpx;
  color: #7e6b61;
  letter-spacing: 2rpx;
}

.stats-section {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 253, 248, 0.86);
  border: 1rpx solid rgba(130, 90, 64, 0.08);
  border-radius: 28rpx;
  padding: 28rpx 34rpx;
  margin-bottom: 34rpx;
  box-shadow: 0 10rpx 28rpx rgba(99, 70, 48, 0.08);
  animation: slideUp 0.72s ease-out both;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 26rpx;
}

.stat-number {
  font-size: 38rpx;
  font-weight: 800;
  color: #db7b5d;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #7e6b61;
}

.stat-divider {
  width: 2rpx;
  height: 58rpx;
  background: linear-gradient(180deg, transparent, rgba(126, 107, 97, 0.24), transparent);
}

.features-section {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  animation: slideUp 0.72s ease-out both;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 390rpx;
  background: rgba(255, 253, 248, 0.9);
  padding: 18rpx 26rpx;
  border-radius: 18rpx;
  box-shadow: 0 6rpx 16rpx rgba(99, 70, 48, 0.07);
}

.feature-icon-img {
  width: 46rpx;
  height: 46rpx;
  border-radius: 12rpx;
}

.feature-text {
  font-size: 26rpx;
  color: #574039;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(34rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.bottom-section {
  position: relative;
  z-index: 3;
  width: 100%;
  padding: 0 56rpx 58rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  border-radius: 100rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.btn-enter {
  padding: 28rpx 0;
  color: #fffdf8;
  background: linear-gradient(135deg, #db7b5d, #c95f55);
  box-shadow: 0 14rpx 34rpx rgba(201, 95, 85, 0.24);
}

.btn-enter:active,
.btn-login:active {
  transform: scale(0.985);
}

.btn-login {
  padding: 24rpx 0;
  color: #6b5a52;
  background: rgba(255, 253, 248, 0.92);
  border: 1rpx solid rgba(126, 107, 97, 0.16);
}

.btn-arrow {
  font-size: 32rpx;
  margin-left: 4rpx;
  animation: arrowMove 1.5s ease-in-out infinite;
}

@keyframes arrowMove {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(9rpx); }
}

.privacy-note {
  width: 100%;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8a796f;
  text-align: center;
}

.version {
  position: absolute;
  bottom: 18rpx;
  right: 28rpx;
  font-size: 20rpx;
  color: rgba(87, 64, 57, 0.42);
  z-index: 3;
}
