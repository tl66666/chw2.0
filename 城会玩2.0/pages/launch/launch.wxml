<view class="launch-container">
  <image class="bg-image" src="/images/launch/bg.jpg" mode="aspectFill"/>

  <view class="paper-grain"></view>
  <view class="bg-decoration">
    <view class="circle circle-1"></view>
    <view class="circle circle-2"></view>
    <view class="circle circle-3"></view>
  </view>

  <view class="content">
    <view class="logo-section">
      <view class="logo-wrapper">
        <image class="logo-image" src="/images/launch/logo.jpg" mode="aspectFit"/>
        <view class="logo-glow"></view>
      </view>
      <view class="app-name">城会玩2.0</view>
      <view class="app-slogan">点亮城市，收集你的旅行角色卡</view>
    </view>

    <view class="stats-section" wx:if="{{showStats}}">
      <view class="stat-item">
        <view class="stat-number">391</view>
        <view class="stat-label">城市坐标</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-number">34</view>
        <view class="stat-label">省级地图</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-number">∞</view>
        <view class="stat-label">旅行照片</view>
      </view>
    </view>

    <view class="features-section" wx:if="{{showFeatures}}">
      <view class="feature-item">
        <image class="feature-icon-img" src="/images/launch/icon-map.jpg" mode="aspectFit"/>
        <view class="feature-text">点亮中国地图</view>
      </view>
      <view class="feature-item">
        <image class="feature-icon-img" src="/images/launch/icon-camera.jpg" mode="aspectFit"/>
        <view class="feature-text">记录旅行瞬间</view>
      </view>
      <view class="feature-item">
        <image class="feature-icon-img" src="/images/launch/icon-friends.jpg" mode="aspectFit"/>
        <view class="feature-text">和好友共享群组图鉴</view>
      </view>
    </view>
  </view>

  <view class="bottom-section">
    <view class="btn btn-enter" bindtap="enterApp">
      <view class="btn-text">进入体验</view>
      <view class="btn-arrow">→</view>
    </view>
    <view class="btn btn-login" bindtap="goProfileLogin">
      <view class="btn-text">已有数据，去“我的”登录同步</view>
    </view>
    <view class="privacy-note">
      浏览基础功能无需授权；需要云端同步、群组和照片共享时，可在“我的”页主动登录。
    </view>
  </view>

  <view class="version">城会玩2.0</view>
</view>
