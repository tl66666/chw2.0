page { background: #F6F5F1; }
.province-page { min-height: 100vh; padding-bottom: 44rpx; color: #29342E; }
.province-cover-wrap { position: relative; height: 436rpx; overflow: hidden; background: #315F57; }
.province-cover, .province-cover-fallback, .cover-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.province-cover { display: block; }
.province-cover-fallback { display: flex; align-items: center; justify-content: center; background: #315F57; }
.cover-abbr { color: rgba(255,255,255,.18); font-size: 180rpx; font-weight: 900; }
.cover-shade { background: linear-gradient(180deg, rgba(18,31,25,.08) 20%, rgba(18,31,25,.74) 100%); }
.cover-copy { position: absolute; right: 32rpx; bottom: 34rpx; left: 32rpx; color: #FFFFFF; }
.cover-kicker, .cover-title, .cover-summary { display: block; }
.cover-kicker { font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; opacity: .84; }
.cover-title { margin-top: 9rpx; font-size: 58rpx; font-weight: 900; line-height: 1.1; }
.cover-summary { margin-top: 13rpx; font-size: 23rpx; opacity: .9; }
.province-overview { display: flex; align-items: stretch; justify-content: space-around; margin: -28rpx 24rpx 0; padding: 25rpx 10rpx; position: relative; z-index: 1; background: #FFFFFF; box-shadow: 0 12rpx 30rpx rgba(31, 48, 39, .1); }
.overview-item { flex: 1; min-width: 0; text-align: center; }
.overview-number, .overview-label { display: block; }
.overview-number { color: #315F57; font-size: 35rpx; font-weight: 900; }
.overview-label { margin-top: 5rpx; color: #758079; font-size: 20rpx; }
.overview-divider { width: 1rpx; background: #E6E9E2; }
.progress-panel { margin: 22rpx 24rpx 0; padding: 22rpx 24rpx; background: #FFFFFF; }
.progress-row { display: flex; justify-content: space-between; color: #536259; font-size: 23rpx; font-weight: 700; }
.progress-track { height: 8rpx; margin-top: 15rpx; overflow: hidden; background: #E5ECE5; border-radius: 8rpx; }
.progress-fill { height: 100%; background: #D86C4B; border-radius: inherit; }
.province-card-entry { display: flex; align-items: center; justify-content: space-between; margin: 18rpx 24rpx 0; padding: 23rpx 25rpx; color: #FFFFFF; background: #315F57; }
.entry-kicker, .entry-title { display: block; }
.entry-kicker { color: #C8DED4; font-size: 18rpx; letter-spacing: 1rpx; }
.entry-title { margin-top: 7rpx; font-size: 27rpx; font-weight: 800; }
.entry-arrow { font-size: 44rpx; line-height: 1; }
.city-section { margin: 34rpx 24rpx 0; }
.section-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 17rpx; }
.section-title, .section-subtitle { display: block; }
.section-title { color: #29342E; font-size: 33rpx; font-weight: 900; }
.section-subtitle { margin-top: 6rpx; color: #7C857E; font-size: 20rpx; }
.section-count { color: #D86C4B; font-size: 25rpx; font-weight: 900; }
.city-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.city-atlas-card { min-width: 0; overflow: hidden; background: #FFFFFF; box-shadow: 0 7rpx 18rpx rgba(32, 48, 39, .07); }
.city-atlas-card:active { opacity: .78; transform: scale(.98); }
.city-photo-area, .city-no-photo { position: relative; height: 186rpx; overflow: hidden; }
.city-real-photo { width: 100%; height: 100%; display: block; }
.photo-shade { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 45%, rgba(0,0,0,.46)); }
.photo-count { position: absolute; right: 13rpx; bottom: 11rpx; color: #FFFFFF; font-size: 18rpx; font-weight: 700; }
.city-no-photo { display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end; padding: 17rpx; box-sizing: border-box; background: #E9EEE8; }
.city-no-photo::before { content: ''; position: absolute; top: 18rpx; right: 16rpx; width: 46rpx; height: 46rpx; border: 2rpx solid rgba(49,95,87,.18); border-radius: 50%; }
.city-no-photo::after { content: ''; position: absolute; top: 42rpx; right: 34rpx; width: 82rpx; height: 2rpx; background: rgba(49,95,87,.18); transform: rotate(-35deg); }
.city-no-photo-name, .city-no-photo-note { position: relative; z-index: 1; display: block; }
.city-no-photo-name { color: #315F57; font-size: 31rpx; font-weight: 900; }
.city-no-photo-note { margin-top: 4rpx; color: #7A887F; font-size: 18rpx; }
.city-card-copy { min-height: 143rpx; padding: 16rpx; box-sizing: border-box; }
.city-name-row { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; }
.city-name { max-width: 58%; overflow: hidden; color: #29342E; font-size: 28rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.city-state { flex-shrink: 0; color: #88918B; font-size: 17rpx; }
.city-state.is-recorded { color: #D86C4B; }
.city-primary-landmark { display: block; margin-top: 10rpx; overflow: hidden; color: #466056; font-size: 22rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.city-landmark-tags { display: flex; gap: 7rpx; margin-top: 10rpx; overflow: hidden; }
.city-landmark-tag { flex-shrink: 0; padding: 4rpx 8rpx; color: #7D6250; background: #F5ECE4; font-size: 17rpx; line-height: 1.2; }
