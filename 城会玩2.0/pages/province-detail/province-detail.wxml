<view class="province-page">
  <view class="province-cover-wrap">
    <image class="province-cover" wx:if="{{provinceCover}}" src="{{provinceCover}}" mode="aspectFill" />
    <view class="province-cover-fallback" wx:else><text class="cover-abbr">{{provinceAbbr}}</text></view>
    <view class="cover-shade"></view>
    <view class="cover-copy">
      <text class="cover-kicker">地图足迹</text>
      <text class="cover-title">{{provinceName}}</text>
      <text class="cover-summary">{{isProvinceVisited ? '这片地图已经点亮' : '点亮这片地图，收下对应角色卡'}}</text>
    </view>
  </view>

  <view class="province-status">
    <view class="status-mark {{isProvinceVisited ? 'is-visited' : ''}}"><text>{{isProvinceVisited ? '✓' : '○'}}</text></view>
    <view class="status-copy"><text class="status-title">{{isProvinceVisited ? '已点亮省份' : '还未点亮'}}</text><text class="status-desc">省份打卡不会新增或改变下属城市记录</text></view>
  </view>

  <view class="province-action {{isProvinceVisited ? 'is-visited' : ''}}" bindtap="toggleProvinceVisit">
    <view><text class="action-kicker">PROVINCE CHECK-IN</text><text class="action-title">{{isProvinceVisited ? '取消点亮 ' + provinceName : '点亮 ' + provinceName}}</text></view>
    <text class="action-icon">{{isProvinceVisited ? '✓' : '+'}}</text>
  </view>

  <view class="province-card-entry" bindtap="openCard">
    <view><text class="entry-kicker">PROVINCE CARD</text><text class="entry-title">查看对应角色卡</text><text class="entry-desc">{{provinceName}} 专属角色资料</text></view>
    <text class="entry-arrow">›</text>
  </view>

  <view class="province-note"><text>想记录具体城市时，请通过首页搜索进入该城市打卡。</text></view>
</view>
