.container {
  padding: 32rpx;
  background: linear-gradient(180deg, #F8F5F2 0%, #FFF9F5 50%, #F5F0FF 100%);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 页面标题 */
.album-header {
  margin-bottom: 24rpx;
}

.album-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: 0;
}

.album-stats {
  display: flex;
  align-items: center;
}

.stats-text {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 统计卡片 */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex: 1;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
}

.stat-travel {
  color: var(--pink-primary);
}

.stat-food {
  color: #E8A87C;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--border-color);
}

/* 照片分类标签 */
.photo-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.photo-tab {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0 12rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  box-shadow: var(--shadow-sm);
  height: 80rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.photo-tab.active {
  border-color: var(--pink-primary);
  background: linear-gradient(135deg, rgba(244, 166, 181, 0.12) 0%, rgba(244, 166, 181, 0.04) 100%);
}

.tab-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
  height: 26rpx;
  line-height: 26rpx;
  display: inline-block;
  white-space: nowrap;
}

.photo-tab.active .tab-text {
  color: var(--pink-primary);
  font-weight: 600;
}

.tab-count {
  font-size: 18rpx;
  color: #FFFFFF;
  background: var(--pink-primary);
  padding: 2rpx 10rpx;
  border-radius: 100rpx;
  height: 18rpx;
  line-height: 18rpx;
  display: inline-block;
  flex-shrink: 0;
  font-weight: 500;
}

/* 城市筛选 */
.city-filter-section {
  margin-bottom: 24rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 20rpx 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.filter-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.filter-count {
  font-size: 22rpx;
  color: var(--text-muted);
}

.city-tags {
  white-space: nowrap;
}

.tags-list {
  display: inline-flex;
  gap: 12rpx;
  padding-bottom: 4rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 24rpx;
  background: var(--bg-primary);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.tag-active {
  border-color: var(--pink-primary);
  background: linear-gradient(135deg, rgba(244, 166, 181, 0.12) 0%, rgba(244, 166, 181, 0.04) 100%);
}

.tag-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
  white-space: nowrap;
}

.tag-active .tag-text {
  color: var(--pink-primary);
  font-weight: 600;
}

.tag-badge {
  font-size: 18rpx;
  color: #FFFFFF;
  background: var(--text-muted);
  padding: 2rpx 8rpx;
  border-radius: 100rpx;
  min-width: 24rpx;
  text-align: center;
  line-height: 1;
}

.tag-active .tag-badge {
  background: var(--pink-primary);
}

.longpress-hint {
  text-align: center;
  padding: 8rpx 0 16rpx;
}

.longpress-hint text {
  font-size: 22rpx;
  color: #999;
}

/* 照片网格 */
.photos-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.photo-card {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  aspect-ratio: 1;
  background: var(--bg-card);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.photo-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

.photo-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.photo-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: linear-gradient(transparent 0%, rgba(0,0,0,0.6) 100%);
}

.photo-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.photo-meta-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.photo-city {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.photo-type {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 100rpx;
  font-weight: 500;
}

.type-travel {
  background: rgba(244, 166, 181, 0.9);
  color: #FFFFFF;
}

.type-food {
  background: rgba(232, 168, 124, 0.9);
  color: #FFFFFF;
}

.photo-date {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  gap: 20rpx;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.6;
  margin-bottom: 8rpx;
}

.empty-title {
  font-size: 32rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  text-align: center;
}

.empty-btn {
  margin-top: 16rpx;
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  height: 32rpx;
}
