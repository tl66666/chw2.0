.privacy-mask {
  position: fixed;
  z-index: 9999;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(24, 21, 19, 0.42);
  box-sizing: border-box;
}

.privacy-card {
  width: 100%;
  max-width: 620rpx;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 24rpx;
  background: #fffaf4;
  box-shadow: 0 18rpx 48rpx rgba(98, 66, 48, 0.18);
  box-sizing: border-box;
}

.privacy-title {
  margin-bottom: 20rpx;
  color: #3f332c;
  font-size: 34rpx;
  font-weight: 700;
}

.privacy-content {
  color: #6f6259;
  font-size: 27rpx;
  line-height: 1.75;
}

.privacy-link {
  color: #d66f58;
  font-weight: 600;
}

.privacy-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 34rpx;
}

.privacy-btn {
  flex: 1;
  height: 82rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 82rpx;
}

.privacy-btn::after {
  border: 0;
}

.privacy-btn.secondary {
  color: #8f7d72;
  background: #f1e8df;
}

.privacy-btn.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #d66f58, #b9574d);
}
