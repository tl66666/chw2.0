/* ========================
   页面容器
======================== */
.page-container {
  min-height: 100vh;
  background: #FFF8F1;
  padding-bottom: 48rpx;
}

/* ========================
   头部区域
======================== */
.header-section {
  position: relative;
  background:
    radial-gradient(circle at 82% 16%, rgba(255, 220, 142, 0.38), transparent 32%),
    linear-gradient(135deg, #d66f58 0%, #bf8064 48%, #78b6a6 100%);
  padding: 48rpx 32rpx 80rpx;
  overflow: hidden;
}

.header-bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.decoration-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.circle-1 {
  width: 300rpx;
  height: 300rpx;
  top: -100rpx;
  right: -80rpx;
}

.circle-2 {
  width: 200rpx;
  height: 200rpx;
  bottom: -60rpx;
  left: -60rpx;
}

.circle-3 {
  width: 150rpx;
  height: 150rpx;
  top: 40rpx;
  left: 30%;
}

.header-content {
  position: relative;
  z-index: 1;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
}

/* ========================
   加载中
======================== */
.loading-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E0E0E0;
  border-top-color: #d66f58;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #666666;
}

/* ========================
   群组信息卡片
======================== */
.group-info-card {
  margin: -40rpx 24rpx 20rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 2;
}

.group-name-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.group-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #2D3436;
}

.group-badge {
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #d66f58, #b9574d);
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.member-badge {
  background: linear-gradient(135deg, #78b6a6, #4c9b8a);
}

.group-type-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.type-tag {
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.type-friends {
  background: #E8F3EF;
  color: #377E70;
}

.type-couple {
  background: #FFF0EA;
  color: #C76252;
}

.type-family {
  background: #FFF5D9;
  color: #9B7428;
}

.group-code {
  font-size: 24rpx;
  color: #666666;
  font-family: monospace;
}

/* ========================
   统计网格
======================== */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin: 0 24rpx 24rpx;
}

.stat-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stat-icon {
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto 8rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
}

.icon-members {
  background: linear-gradient(135deg, #d66f58, #b9574d);
}

.icon-cities {
  background: linear-gradient(135deg, #78b6a6, #4c9b8a);
}

.icon-provinces {
  background: linear-gradient(135deg, #e0a84f, #ca8334);
}

.icon-photos {
  background: linear-gradient(135deg, #ba8f72, #8f6651);
}

.stat-number {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3436;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: #666666;
  margin-top: 4rpx;
  display: block;
}

/* ========================
   照片区域
======================== */
.photos-section {
  margin: 0 24rpx 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3436;
}

.section-subtitle {
  font-size: 22rpx;
  color: #999999;
}

.section-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #d66f58;
}

.section-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.no-photos-hint {
  padding: 32rpx 16rpx;
  text-align: center;
}

.hint-text {
  font-size: 24rpx;
  color: #B0B0B0;
  line-height: 1.6;
}

.arrow-right {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #d66f58;
  border-right: 3rpx solid #d66f58;
  transform: rotate(45deg);
}

.photos-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
}

.photo-item {
  position: relative;
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 8rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
}

.photo-user-avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #FFFFFF;
}

/* ========================
   成员列表
======================== */
.members-section {
  margin: 0 24rpx 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.member-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.member-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #F8F9FA;
}

.creator-item {
  background: linear-gradient(135deg, rgba(214, 111, 88, 0.1), rgba(120, 182, 166, 0.12));
  border: 1rpx solid rgba(214, 111, 88, 0.16);
}

.member-rank {
  flex-shrink: 0;
}

.rank-badge {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.rank-0 {
  background: linear-gradient(135deg, #FFD700, #FFA500);
}

.rank-1 {
  background: linear-gradient(135deg, #C0C0C0, #A0A0A0);
}

.rank-2 {
  background: linear-gradient(135deg, #CD7F32, #B87333);
}

.rank-other {
  background: #E0E0E0;
  color: #666666;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.member-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3436;
}

.role-tag {
  padding: 2rpx 8rpx;
  background: linear-gradient(135deg, #d66f58, #b9574d);
  border-radius: 6rpx;
  font-size: 18rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.admin-tag {
  background: linear-gradient(135deg, #78b6a6, #4c9b8a);
}

.member-stats-row {
  display: flex;
  gap: 16rpx;
}

.member-stat {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #666666;
}

.stat-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}

.dot-city {
  background: #d66f58;
}

.dot-photo {
  background: #78b6a6;
}

.member-score {
  text-align: center;
  flex-shrink: 0;
}

.score-number {
  font-size: 32rpx;
  font-weight: 700;
  color: #d66f58;
  display: block;
}

.score-label {
  font-size: 20rpx;
  color: #999999;
}

/* ========================
   操作按钮区域
======================== */
.action-section {
  display: flex;
  gap: 16rpx;
  margin: 0 24rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border: none;
  font-size: 24rpx;
  color: #2D3436;
  font-weight: 500;
}

.action-btn::after {
  border: none;
}

.invite-btn .btn-icon {
  background: linear-gradient(135deg, #d66f58, #b9574d);
}

.share-btn .btn-icon {
  background: linear-gradient(135deg, #78b6a6, #4c9b8a);
}

.leave-btn .btn-icon {
  background: linear-gradient(135deg, #ff6b6b, #ee5a24);
}

.btn-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 21rpx;
  font-weight: 700;
}

/* ========================
   空状态
======================== */
.empty-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
}

.empty-illustration {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
}

.empty-circle {
  position: absolute;
  border-radius: 50%;
}

.outer {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, rgba(214, 111, 88, 0.12), rgba(120, 182, 166, 0.12));
  top: 0;
  left: 0;
}

.inner {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, rgba(214, 111, 88, 0.18), rgba(120, 182, 166, 0.16));
  top: 30rpx;
  left: 30rpx;
}

.empty-icon-wrapper {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #d66f58, #78b6a6);
  border-radius: 24rpx;
  opacity: 0.8;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2D3436;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #666666;
  text-align: center;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.btn-primary {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #d66f58, #b9574d);
  border-radius: 16rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-secondary {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  color: #d66f58;
  font-size: 28rpx;
  font-weight: 600;
  border: 2rpx solid #d66f58;
}

/* ========================
   弹窗
======================== */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 48rpx;
}

.modal-content {
  width: 100%;
  max-width: 600rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  animation: modalSlideUp 0.3s ease;
}

@keyframes modalSlideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 28rpx 16rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3436;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  position: relative;
  cursor: pointer;
}

.modal-close::before,
.modal-close::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 24rpx;
  height: 3rpx;
  background: #999999;
  border-radius: 2rpx;
}

.modal-close::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.modal-close::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.modal-body {
  padding: 16rpx 28rpx;
}

/* 表单组 */
.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 12rpx;
  display: block;
  font-weight: 600;
}

.form-input {
  width: 100%;
  min-height: 88rpx;
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #2D3436;
  box-sizing: border-box;
  border: 2rpx solid #E0E0E0;
  line-height: 1.4;
  -webkit-appearance: none;
  appearance: none;
}

.form-input:focus {
  border-color: #d66f58;
  background: #FFFFFF;
  outline: none;
}

.form-input::placeholder {
  color: #999999;
  font-size: 28rpx;
}

/* 群组类型选择器 */
.type-selector {
  display: flex;
  gap: 16rpx;
}

.type-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 12rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.type-option.active {
  background: linear-gradient(135deg, rgba(214, 111, 88, 0.1), rgba(120, 182, 166, 0.12));
  border-color: #d66f58;
}

.type-icon {
  font-size: 40rpx;
}

.type-name {
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
}

.type-option.active .type-name {
  color: #d66f58;
  font-weight: 600;
}

.code-input {
  width: 100%;
  min-height: 100rpx;
  padding: 28rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  font-size: 40rpx;
  text-align: center;
  letter-spacing: 12rpx;
  font-weight: 700;
  color: #d66f58;
  box-sizing: border-box;
  border: 2rpx solid #E0E0E0;
  line-height: 1.4;
  -webkit-appearance: none;
  appearance: none;
}

.code-input:focus {
  border-color: #d66f58;
  background: #FFFFFF;
  outline: none;
}

.code-input::placeholder {
  color: #BBBBBB;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  font-weight: 400;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 28rpx 28rpx;
}

.modal-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}

.modal-btn::after {
  border: none;
}

.modal-btn.cancel {
  background: #F5F5F5;
  color: #666666;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #d66f58, #b9574d);
  color: #FFFFFF;
}

.modal-btn.share-confirm {
  background: linear-gradient(135deg, #78b6a6, #4c9b8a);
  color: #FFFFFF;
}

/* ========================
   邀请码展示
======================== */
.invite-code-box {
  text-align: center;
  padding: 32rpx;
}

.invite-code-label {
  font-size: 26rpx;
  color: #666666;
  display: block;
  margin-bottom: 16rpx;
}

.invite-code-text {
  font-size: 56rpx;
  font-weight: 700;
  color: #d66f58;
  letter-spacing: 8rpx;
  display: block;
  margin-bottom: 16rpx;
  font-family: monospace;
}

.invite-code-hint {
  font-size: 24rpx;
  color: #999999;
  display: block;
}

/* ========================
   照片墙弹窗
======================== */
.photos-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #000000;
  z-index: 2000;
  display: flex;
  flex-direction: column;
}

.photos-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.8);
}

.photos-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.photos-modal-close {
  width: 48rpx;
  height: 48rpx;
  position: relative;
}

.photos-modal-close::before,
.photos-modal-close::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 28rpx;
  height: 3rpx;
  background: #FFFFFF;
  border-radius: 2rpx;
}

.photos-modal-close::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.photos-modal-close::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.photos-swiper {
  flex: 1;
}

.swiper-image-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 32rpx;
}

.swiper-image {
  max-width: 100%;
  max-height: 70%;
}

.photo-info-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 100rpx;
}

.photo-info-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.photo-info-name {
  font-size: 28rpx;
  color: #FFFFFF;
}

.photos-indicator {
  text-align: center;
  padding: 24rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}
