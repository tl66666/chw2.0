.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF8F0 0%, #F5EDE4 100%);
  padding-bottom: 40rpx;
}

/* 顶部进度区域 */
.header-section {
  background: linear-gradient(135deg, #E8A87C 0%, #C38D6B 50%, #A67B5B 100%);
  padding: 40rpx 30rpx 60rpx;
  position: relative;
  overflow: hidden;
}

.header-section::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.header-section::after {
  content: '';
  position: absolute;
  bottom: -30%;
  left: -10%;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
  border-radius: 50%;
}

.progress-ring-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}

/* 环形进度条 */
.progress-ring {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  margin-bottom: 30rpx;
}

.progress-ring-bg {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: conic-gradient(
    from 0deg,
    rgba(255,255,255,0.3) 0%,
    rgba(255,255,255,0.3) 100%
  );
  mask: radial-gradient(transparent 55%, black 56%);
  -webkit-mask: radial-gradient(transparent 55%, black 56%);
}

.progress-ring-fill {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: conic-gradient(
    from 0deg,
    #FFD700 0%,
    #FFA500 calc(var(--progress) * 1%),
    transparent calc(var(--progress) * 1%)
  );
  mask: radial-gradient(transparent 55%, black 56%);
  -webkit-mask: radial-gradient(transparent 55%, black 56%);
  transition: background 0.6s ease;
}

.progress-ring-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.progress-percent {
  font-size: 48rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1;
}

.progress-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
}

/* 顶部统计 */
.header-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
}

.stat-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 120rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 50rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 分类标签 */
.category-tabs {
  display: flex;
  padding: 20rpx 20rpx 10rpx;
  gap: 12rpx;
  overflow-x: auto;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  position: sticky;
  top: 0;
  z-index: 10;
}

.category-tab {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  border-radius: 30rpx;
  background: #F5EDE4;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.category-tab.active {
  background: linear-gradient(135deg, #E8A87C 0%, #C38D6B 100%);
  box-shadow: 0 4rpx 12rpx rgba(195, 141, 107, 0.3);
}

.tab-text {
  font-size: 26rpx;
  color: #8B7355;
  font-weight: 500;
}

.category-tab.active .tab-text {
  color: #FFFFFF;
  font-weight: 600;
}

.tab-count {
  font-size: 20rpx;
  color: #A09080;
  background: rgba(255, 255, 255, 0.6);
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  min-width: 28rpx;
  text-align: center;
}

.category-tab.active .tab-count {
  color: #C38D6B;
  background: rgba(255, 255, 255, 0.9);
}

/* 成就列表 */
.achievement-list {
  padding: 20rpx;
}

.achievement-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  background: #FFFFFF;
  padding: 24rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.achievement-item.locked {
  opacity: 0.85;
}

.achievement-item.unlocked {
  border-color: #D4A574;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBF5 100%);
}

.achievement-item.can-unlock {
  border-color: #E8A87C;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { box-shadow: 0 4rpx 16rpx rgba(232, 168, 124, 0.2); }
  50% { box-shadow: 0 4rpx 24rpx rgba(232, 168, 124, 0.4); }
}

/* 完成标识 */
.completed-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 36rpx;
  height: 36rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(255, 165, 0, 0.4);
  z-index: 2;
}

.check-icon {
  width: 18rpx;
  height: 10rpx;
  border-left: 3rpx solid #FFFFFF;
  border-bottom: 3rpx solid #FFFFFF;
  transform: rotate(-45deg) translate(2rpx, -2rpx);
}

/* 图标区域 */
.achievement-icon {
  flex-shrink: 0;
  margin-top: 4rpx;
}

.achievement-badge-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: block;
}

.achievement-badge-img.grayscale {
  filter: grayscale(0.6);
  opacity: 0.6;
}

/* 信息区域 */
.achievement-info {
  flex: 1;
  min-width: 0;
}

.achievement-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.achievement-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3D3229;
}

.locked .achievement-title {
  color: #8B7D6B;
}

.category-tag {
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.category-tag.explore {
  background: rgba(232, 168, 124, 0.15);
  color: #B87A4F;
}

.category-tag.collect {
  background: rgba(125, 185, 168, 0.15);
  color: #4A8B7A;
}

.category-tag.social {
  background: rgba(155, 181, 206, 0.15);
  color: #5A7FA0;
}

.category-tag.special {
  background: rgba(201, 160, 220, 0.15);
  color: #8B6BA0;
}

.achievement-desc {
  font-size: 24rpx;
  color: #9A8B7A;
  line-height: 1.4;
  display: block;
}

.locked .achievement-desc {
  color: #B5A99A;
}

/* 进度条 */
.progress-bar-container {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.progress-bar-bg {
  flex: 1;
  height: 10rpx;
  background: #F0E8E0;
  border-radius: 5rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #E8A87C 0%, #D4956A 100%);
  border-radius: 5rpx;
  transition: width 0.6s ease;
}

.progress-text {
  font-size: 20rpx;
  color: #C38D6B;
  font-weight: 600;
  flex-shrink: 0;
  min-width: 60rpx;
  text-align: right;
}

/* 奖励区域 */
.achievement-reward {
  flex-shrink: 0;
  align-self: center;
}

.reward-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: #F8F3EE;
  border: 2rpx solid #EDE5DC;
}

.reward-box.unlocked {
  background: linear-gradient(135deg, #FFF8E7 0%, #FFF0D4 100%);
  border-color: #E8C880;
}

.reward-value {
  font-size: 28rpx;
  font-weight: 800;
  color: #C4A574;
}

.reward-box.unlocked .reward-value {
  color: #D4A017;
}

.reward-unit {
  font-size: 18rpx;
  color: #B5A99A;
  margin-top: 2rpx;
}

.reward-box.unlocked .reward-unit {
  color: #C4A060;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
  position: relative;
}

.empty-icon-bg {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, #F0E8E0 0%, #E5DCD2 100%);
  position: relative;
}

.empty-icon-bg::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #D4C4B0;
  border-radius: 50%;
}

.empty-icon-bg::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 24rpx;
  height: 24rpx;
  background: #D4C4B0;
  border-radius: 50%;
}

.empty-text {
  font-size: 32rpx;
  color: #8B7D6B;
  font-weight: 600;
}

.empty-desc {
  font-size: 24rpx;
  color: #B5A99A;
  margin-top: 12rpx;
}

/* 成就解锁弹窗 */
.achievement-popup {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.achievement-popup.show {
  opacity: 1;
  pointer-events: auto;
}

.achievement-popup-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
}

.achievement-popup-content {
  position: relative;
  z-index: 2;
  width: 80vw;
  max-width: 560rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF8F0 100%);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  transform: scale(0.8) translateY(50rpx);
  transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  border: 2rpx solid rgba(212, 165, 116, 0.2);
}

.achievement-popup.show .achievement-popup-content {
  transform: scale(1) translateY(0);
}

.achievement-popup-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFD700 0%, #F5A623 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(245, 166, 35, 0.4);
  animation: achievementIconPulse 1.5s ease-in-out infinite;
}

@keyframes achievementIconPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.achievement-popup-icon text {
  font-size: 60rpx;
}

.achievement-popup-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #3D3229;
  display: block;
  margin-bottom: 8rpx;
}

.achievement-popup-name {
  font-size: 28rpx;
  color: #C38D6B;
  font-weight: 700;
  display: block;
  margin-bottom: 20rpx;
}

.achievement-popup-reward {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 28rpx;
  background: linear-gradient(135deg, #FFD700 0%, #F5A623 100%);
  border-radius: 100rpx;
  margin-bottom: 28rpx;
}

.achievement-popup-reward text {
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.achievement-popup-btn {
  padding: 22rpx 56rpx;
  background: linear-gradient(135deg, #E8A87C 0%, #C38D6B 100%);
  border-radius: 100rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: inline-block;
  box-shadow: 0 4rpx 16rpx rgba(195, 141, 107, 0.3);
}

/* 已解锁状态文字 */
.unlocked-date {
  margin-top: 8rpx;
}

.unlocked-date text {
  font-size: 22rpx;
  color: #7DB9A8;
  font-weight: 500;
}

.achievement-popup-bg {
  background: rgba(34, 26, 22, 0.46);
  backdrop-filter: blur(10rpx);
}

.achievement-popup-content {
  text-align: left;
  background:
    radial-gradient(circle at 88% 18%, rgba(120, 182, 166, 0.24), transparent 28%),
    linear-gradient(135deg, #FFFDF8 0%, #FFF1E8 100%);
}

.achievement-popup-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 0 20rpx;
  border-radius: 32rpx;
  background: transparent;
  box-shadow: none;
}

.achievement-popup-badge-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 36rpx;
  background: #FFFFFF;
  box-shadow: 0 14rpx 32rpx rgba(214, 111, 88, 0.22);
}

.achievement-popup-title {
  color: #C9915F;
  font-size: 24rpx;
}

.achievement-popup-name {
  color: #3F3732;
  font-size: 40rpx;
}

.achievement-popup-desc {
  display: block;
  margin: 10rpx 0 18rpx;
  color: #8A786E;
  font-size: 25rpx;
  line-height: 1.45;
}
